---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "/beta"

const featuredDesc = `Ice in Practice is Henry’s first book, a field guide for the people who work where the ice does — polar expedition guides, field operations professionals, and students of the cryosphere. In it, Henry shows that the best decisions — on glaciers, sea ice, and tidewater termini — all share the same habit of mind, and it’s not the one most training programmes teach. He calls this approach Observe — Understand — Decide — Communicate, and it provides a framework that turns a crevasse field or a calving face from a hazard to be feared into a landscape that can be read.`;

const lorem1 = `Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum molestie augue nec mauris posuere aliquam. Fusce velit magna, auctor at fringilla vitae, sodales vel dui. Curabitur dictum posuere semper. Donec at posuere nibh. Proin a sem sit amet neque molestie egestas eget sit amet risus. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Praesent a mauris est. Vivamus tincidunt feugiat interdum. Fusce sit amet velit pretium, condimentum magna ac, dictum odio.`;
const lorem2 = `Duis quam enim, tempus non leo eu, posuere tincidunt sem. Duis nec metus consectetur turpis sagittis fermentum. Proin in vestibulum turpis. In volutpat nibh et augue tristique, nec venenatis libero euismod. Nunc mattis, libero eu vulputate eleifend, arcu enim malesuada nibh, vel rutrum tortor libero eu nisi. Vivamus eu ultricies nibh, eu faucibus massa. Curabitur volutpat accumsan eleifend. Aliquam vestibulum consequat lectus eget consequat.`;
const lorem3 = `Aenean placerat ligula in sodales blandit. Nullam ac vehicula sem. Suspendisse eget pellentesque est. Nullam sit ligula a lacus ultricies rutrum. Morbi id sodales augue. Curabitur vel dui dapibus, mollis diam nec, auctor neque. Pellentesque consequat sodales tellus vel molestie. Fusce nec turpis id sem hendrerit tempus sit amet a purus. Integer vehicula massa id ex luctus convallis. Nam tincidunt, nisl vitae hendrerit lacinia, ligula odio facilisis augue.`;
const lorem4 = `Nullam eget vehicula turpis, aliquam mattis metus. Mauris sit amet interdum massa, efficitur tincidunt elit. Integer id eros ac justa fringilla imperdiet et vitae mi. Mauris hendrerit commodo purus, eu viverra elit molestie quis. Nulla tempus nulla ante, quis gravida turpis ultrices ut. Suspendisse a nisl id justa varius volutpat. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas.`;
---

<BaseLayout title="Books — Henry Páll Wulff">
  <div class="books">
    <!-- ========== FEATURED BOOK ========== -->
    <section class="wrap bkfeat">
      <div class="bkfeat__cover placeholder" aria-label="Ice in Practice — book cover"></div>
      <article class="bkfeat__card">
        <h1 class="bkfeat__title">Ice in Practice</h1>
        <p class="bkfeat__sub">A Field Guide to Understanding and Working in the Cryosphere</p>
        <p class="bkfeat__desc">{featuredDesc}</p>
        <p class="bkfeat__desc bkfeat__desc--last">And it all starts with learning to read the ice.</p>
      </article>
    </section>

    <!-- action bar (full-bleed navy) -->
    <div class="bkbar">
      <div class="wrap bkbar__inner">
        <a class="bkbtn" href="#"><span class="bkbtn__bar">|</span> <b>Read</b> Sample</a>
        <a class="bkbtn" href="#"><span class="bkbtn__bar">|</span> <b>Pre</b> Order</a>
      </div>
    </div>

    <!-- ========== PULL-QUOTE + BODY ========== -->
    <section class="wrap bksec">
      <blockquote class="bkquote">
        The ice is changing faster than the people who work on it can be trained. <i>Ice in Practice</i> is a field guide for reading a cryosphere in transition — for guides, operators, and students whose decisions depend on understanding what the ice is about to do, not what it will do.
      </blockquote>
      <div class="bkbody">
        <p>{lorem1}</p>
        <p>{lorem2}</p>
      </div>
    </section>

    <!-- ========== SECOND FEATURE (image + navy title card) ========== -->
    <section class="wrap bkfeat2">
      <div class="bkfeat2__media placeholder"></div>
      <div class="bkfeat2__card">
        <h2 class="bkfeat2__title">The New Supremacist Survivalists Are Far From Impregnable.</h2>
      </div>
    </section>

    <section class="wrap bksec2">
      <p class="bksec2__kicker">Description Headline</p>
      <div class="bkbody">
        <p>{lorem3}</p>
        <p>{lorem4}</p>
      </div>
    </section>

    <!-- ========== RECEIVE UPDATES BAR ========== -->
    <section class="wrap">
      <div class="bkupdates">
        <p class="bkupdates__label">Receive updates on <i>Ice in Practice</i></p>
        <form class="bkupdates__form" onsubmit="return false">
          <input type="text" name="cm-name" placeholder="Your Name" aria-label="Your Name" />
          <input type="email" name="cm-email" placeholder="Your Email" aria-label="Your Email" />
          <button class="bkupdates__join" type="submit">Join Now</button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .wrap { position: relative; width: min(1104px, calc(100% - 2.5rem)); margin-inline: auto; }
  .books { padding-top: 70px; padding-bottom: 3rem; }

  /* ---------- FEATURED BOOK (cover overlaps a navy info card) ---------- */
  .bkfeat { position: relative; }
  .bkfeat__cover {
    position: absolute; left: 16%; top: 0; width: 230px; aspect-ratio: 230 / 350; z-index: 2;
    background: var(--placeholder); box-shadow: 0 22px 50px rgba(17, 41, 46, 0.28);
  }
  .bkfeat__card {
    margin-left: 20%; margin-top: 34px; min-height: 296px;
    background: var(--navy); color: #fff;
    padding: 46px 56px 44px 210px;
  }
  .bkfeat__title { margin: 0 0 0.5rem; font-size: clamp(1.7rem, 3.4vw, 38px); font-weight: 600; text-transform: uppercase; line-height: 1.1; }
  .bkfeat__sub { margin: 0 0 1.4rem; font-size: clamp(1rem, 1.7vw, 18px); font-weight: 400; line-height: 1.4; color: #e9edef; }
  .bkfeat__desc { margin: 0 0 1rem; font-size: 13px; font-style: italic; font-weight: 300; line-height: 1.75; color: #c2ccd0; }
  .bkfeat__desc--last { margin-bottom: 0; color: #dfe6e9; }

  /* ---------- action bar ---------- */
  .bkbar { background: var(--navy); margin-top: 26px; }
  .bkbar__inner { display: flex; gap: 2.5rem; padding: 18px 0; }
  .bkbtn { color: #fff; font-size: 14px; white-space: nowrap; }
  .bkbtn:hover { opacity: 0.75; }
  .bkbtn__bar { font-weight: 300; margin-right: 4px; }
  .bkbtn b { font-weight: 600; }

  /* ---------- pull-quote + two-column body ---------- */
  .bksec { padding-top: 70px; }
  .bkquote {
    width: 41%; margin: 0 0 40px; background: var(--navy); color: #fff;
    padding: 34px 40px; font-size: 15px; font-weight: 300; line-height: 1.6;
  }
  .bkquote i { font-style: italic; }
  .bkbody { columns: 2; column-gap: 48px; }
  .bkbody p { margin: 0 0 1rem; font-size: 13px; font-weight: 300; line-height: 1.9; color: #3a4245; break-inside: avoid; }
  .bkbody p:last-child { margin-bottom: 0; }

  /* ---------- second feature (image full width, navy title card bottom-right) ---------- */
  .bkfeat2 { margin-top: 80px; padding-bottom: 44px; }
  .bkfeat2__media { width: 100%; aspect-ratio: 1091 / 470; background: var(--placeholder); }
  .bkfeat2__card {
    position: absolute; right: 0; bottom: 0; width: 52%;
    background: var(--navy); color: #fff; padding: 26px 34px;
  }
  .bkfeat2__title { margin: 0; font-size: clamp(1.4rem, 2.7vw, 34px); font-weight: 600; text-transform: uppercase; line-height: 1.12; }

  .bksec2 { padding-top: 8px; }
  .bksec2__kicker { margin: 0 0 1.2rem; font-size: 13px; font-weight: 600; }

  /* ---------- receive updates bar ---------- */
  .bkupdates {
    margin-top: 64px; background: var(--navy); color: #fff;
    display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
    padding: 22px 34px;
  }
  .bkupdates__label { margin: 0; font-size: 15px; white-space: nowrap; }
  .bkupdates__label i { font-style: italic; }
  .bkupdates__form { display: flex; gap: 12px; flex: 1; justify-content: flex-end; flex-wrap: wrap; }
  .bkupdates__form input {
    width: 220px; max-width: 100%; height: 44px; padding: 0 1rem; border: 0; border-radius: 6px;
    font-family: inherit; font-size: 0.85rem; background: #fff; color: #11292E; text-align: center;
  }
  .bkupdates__form input::placeholder { color: rgba(0,0,0,0.35); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  .bkupdates__join {
    height: 44px; padding: 0 1.6rem; border: 0; background: #fff; color: #11292E;
    font-family: inherit; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    font-size: 14px; cursor: pointer; border-radius: 6px;
  }
  .bkupdates__join:hover { background: #e6ebed; }

  /* ---------- responsive ---------- */
  @media (max-width: 820px) {
    .bkfeat__cover { position: static; width: 200px; margin: 0 auto 1.5rem; display: block; }
    .bkfeat__card { margin-left: 0; margin-top: 0; padding: 32px 28px; min-height: 0; }
    .bkbody { columns: 1; }
    .bkquote { width: 100%; }
    .bkfeat2__card { position: static; width: 100%; }
    .bkfeat2 { padding-bottom: 0; }
    .bkupdates { flex-direction: column; align-items: stretch; }
    .bkupdates__form { justify-content: stretch; }
    .bkupdates__form input { flex: 1 1 200px; width: auto; }
  }
</style>
