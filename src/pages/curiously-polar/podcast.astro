---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "/beta"

// Body copy is placeholder in the Figma (lorem) — kept as placeholder until real copy is supplied via the CMS.
const intro1 = `Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.`;
const intro2 = `Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.`;
const bodyA = `At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident, similique sunt in culpa qui officia deserunt mollitia animi, id est laborum et dolorum fuga. Et harum quidem rerum facilis est et expedita distinctio. Nam libero tempore, cum soluta nobis est eligendi optio cumque nihil impedit quo minus id quod maxime placeat facere possimus, omnis voluptas assumenda est, omnis dolor repellendus.`;
const bodyB = `Quisque mattis porta ipsum, id blandit nunc fringilla et. Mauris a nulla a ligula sollicitudin feugiat. Vivamus mattis commodo dictum. Vivamus auctor lorem a urna facilisis facilisis. Praesent faucibus erat dui, eu vulputate mauris accumsan eget. Duis maximus interdum nulla eu tristique. Sed tempus nisi felis, non ultrices justo efficitur ac. Nunc eu feugiat nisi, eu cursus dolor.`;

// Episode grid — thumbnails are grey placeholders (episode artwork isn't in Figma as assets).
const eps = [
  { l: '0%',      t: '44px'  },
  { l: '28.07%',  t: '44px'  },
  { l: '0%',      t: '276px' },
  { l: '28.07%',  t: '276px' },
  { l: '0%',      t: '508px' },
  { l: '28.07%',  t: '508px' },
];

const team = [
  { name: 'Chris Marquardt',  l: '29.77%' },
  { name: 'Mario Acquarone',  l: '54.01%' },
  { name: 'Henry Páll Wulff', l: '78.52%' },
];

const gallery = [
  { l: '64.00%', t: '41px',  w: '37.25%', ar: '418 / 255' },
  { l: '64.44%', t: '337px', w: '14.08%', ar: '1 / 1' },
  { l: '81.73%', t: '337px', w: '18.54%', ar: '208 / 294' },
  { l: '64.44%', t: '536px', w: '14.08%', ar: '158 / 257' },
  { l: '81.73%', t: '672px', w: '18.54%', ar: '208 / 121' },
];
---

<BaseLayout title="Curiously Polar — Podcast" description="Curiously Polar — narrating the poles, sharing curiosity. Episodes, the team, and the story behind the podcast.">
  <div class="pod">

    <!-- ============ PODCAST STORY ============ -->
    <section class="pod-sec pod-sec--story">
      <div class="pwrap">
        <div class="canvas canvas--story">
          <span class="wm wm--podcast" aria-hidden="true">PODCAST</span>
          <div class="story__shadow" aria-hidden="true"></div>
          <div class="story__hero placeholder" role="img" aria-label="Curiously Polar hero portrait"></div>
          <h1 class="story__headline">Narrating the poles,<br />sharing curiosity</h1>
          <span class="story__rule" aria-hidden="true"></span>
          <div class="story__intro">
            <p>{intro1}</p>
            <p>{intro2}</p>
          </div>
          <div class="story__body2">
            <p>{bodyA}</p>
            <p class="is-last">{bodyB}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ THE TEAM ============ -->
    <section class="pod-sec pod-sec--team">
      <div class="pwrap">
        <div class="canvas canvas--team">
          <span class="wm wm--team" aria-hidden="true">THE TEAM</span>
          <span class="team__line" aria-hidden="true"></span>
          <blockquote class="team__quote">Do not mind anything that anyone tells you about anyone else. Judge everyone and everything for yourself.</blockquote>
          {team.map((m) => (
            <figure class="team__card" style={`left:${m.l}`}>
              <div class="team__pic placeholder" role="img" aria-label={m.name}></div>
              <figcaption class="team__name">{m.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ EPISODES + GALLERY ============ -->
    <section class="pod-sec pod-sec--eps">
      <div class="pwrap">
        <div class="canvas canvas--eps">
          <span class="wm wm--eps" aria-hidden="true">EPISODES</span>

          {eps.map((e) => (
            <article class="ep" style={`left:${e.l};top:${e.t}`}>
              <div class="ep__thumb placeholder" role="img" aria-label="Episode thumbnail"></div>
              <div class="ep__bar">
                <a class="ep__act" href="#" aria-label="Listen">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>
                  <span>Listen</span>
                </a>
                <a class="ep__act ep__act--watch" href="#" aria-label="Watch">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 8.5l6 3.5-6 3.5z" fill="#11292e"/></svg>
                  <span>Watch</span>
                </a>
              </div>
            </article>
          ))}

          <a class="ep-more" href="#">Load More</a>

          {gallery.map((g) => (
            <div class="gal placeholder" style={`left:${g.l};top:${g.t};width:${g.w};aspect-ratio:${g.ar}`} role="img" aria-label="Gallery photo"></div>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .pod { position: relative; overflow-x: clip; padding-bottom: 4rem; }
  .pwrap { position: relative; width: min(1122px, calc(100% - 3rem)); margin-inline: auto; }
  .canvas { position: relative; }

  /* faded section watermarks (#f5f5f5 Poppins Medium) */
  .wm {
    position: absolute; top: -0.16em; font-family: var(--font); font-weight: 500;
    color: #f5f5f5; white-space: nowrap; line-height: 1; letter-spacing: 0.01em;
    pointer-events: none; user-select: none; z-index: 0;
  }
  .wm--podcast { left: 16.40%; font-size: clamp(88px, 18vw, 200px); }
  .wm--team    { left: -3.03%; font-size: clamp(60px, 13vw, 120px); }
  .wm--eps     { left: -0.18%; font-size: clamp(60px, 13vw, 120px); }

  /* ---------- section spacing (Figma vertical gaps) ---------- */
  .pod-sec--story { padding-top: 74px; }
  .pod-sec--team  { margin-top: 97px; }
  .pod-sec--eps   { margin-top: 93px; }

  /* ===================== PODCAST STORY ===================== */
  .canvas--story { height: 983px; }
  .story__shadow {
    position: absolute; left: -2.41%; top: 57px; width: 44.39%; aspect-ratio: 1 / 1;
    background: var(--navy); z-index: 0;
  }
  .story__hero {
    position: absolute; left: 0.45%; top: 28px; width: 44.39%; aspect-ratio: 1 / 1; z-index: 1;
  }
  .story__headline {
    position: absolute; left: 39.57%; top: 73px; margin: 0; z-index: 2;
    font-weight: 500; font-size: 40px; line-height: 55px; letter-spacing: 0;
    text-transform: uppercase; color: var(--navy);
  }
  .story__rule {
    position: absolute; left: 39.57%; top: 203px; width: 98px; height: 2px;
    background: var(--navy); z-index: 2;
  }
  .story__intro {
    position: absolute; left: 52.05%; top: 217px; width: 47.95%; z-index: 2;
  }
  .story__body2 {
    position: absolute; left: 21.39%; top: 605px; width: 78.61%; z-index: 2;
  }
  .story__intro p, .story__body2 p {
    margin: 0 0 1.1em; font-size: 14px; font-weight: 300; line-height: 1.55; color: #000;
  }
  .story__intro p:last-child, .story__body2 p.is-last { margin-bottom: 0; }

  /* ===================== THE TEAM ===================== */
  .canvas--team { height: 334px; }
  .team__line {
    position: absolute; left: -2.50%; top: 110px; width: 2px; height: 101px; background: var(--navy);
  }
  .team__quote {
    position: absolute; left: 0.27%; top: 113px; width: 22.37%; margin: 0;
    font-size: 16px; font-weight: 400; line-height: 20px; letter-spacing: -0.8px; color: rgba(0,0,0,0.5);
  }
  .team__card { position: absolute; top: 41px; width: 22.73%; margin: 0; }
  .team__pic { width: 100%; aspect-ratio: 1 / 1; }
  .team__name {
    margin: 14px 0 0; font-size: 18px; font-weight: 500; line-height: 24px;
    letter-spacing: -0.9px; color: rgba(0,0,0,0.65); text-transform: uppercase;
  }

  /* ===================== EPISODES + GALLERY ===================== */
  .canvas--eps { height: 793px; }
  .ep { position: absolute; width: 26.74%; }
  .ep__thumb { width: 100%; aspect-ratio: 300 / 169; }
  .ep__bar {
    display: flex; align-items: center; height: 35px; background: var(--navy);
    color: #fff; padding-left: 12px; gap: 45px;
  }
  .ep__act {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 300; color: #fff;
  }
  .ep__act:hover { opacity: 0.75; }
  .ep__act svg { display: block; }

  .ep-more {
    position: absolute; left: 21.21%; top: 763px; width: 12.03%; height: 30px;
    display: grid; place-items: center;
    background: var(--navy); border: 1px solid #fff; color: #fff;
    font-size: 12px; font-weight: 500; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .ep-more:hover { background: var(--navy-800); }

  .gal { position: absolute; z-index: 1; }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 920px) {
    .canvas--story, .canvas--team, .canvas--eps { height: auto; }
    .wm { position: static; display: block; margin-bottom: -0.35em; }

    .story__shadow { display: none; }
    .story__hero { position: static; width: 100%; max-width: 420px; margin: 0 auto 2rem; }
    .story__headline { position: static; margin: 0 0 1rem; font-size: clamp(28px, 7vw, 40px); line-height: 1.2; }
    .story__rule { position: static; margin: 0 0 1.4rem; }
    .story__intro, .story__body2 { position: static; width: 100%; margin: 0 0 1.6rem; }

    .team__line { display: none; }
    .team__quote { position: static; width: 100%; max-width: 460px; margin: 0 0 2rem; font-size: 17px; line-height: 1.5; }
    .team__card { position: static; width: 100%; max-width: 320px; margin: 0 auto 2rem; }

    .ep { position: static; width: 100%; max-width: 420px; margin: 0 auto 1.6rem; }
    .ep-more { position: static; width: 160px; height: 40px; margin: 0.5rem auto 3rem; }
    .gal { position: static; width: 100% !important; max-width: 420px; margin: 0 auto 1rem; aspect-ratio: 4 / 3 !important; }
  }
</style>
