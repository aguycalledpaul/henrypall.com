---
import BaseLayout from '../../layouts/BaseLayout.astro';
import podcast from '../../content/podcast.json';

const { story, team: teamContent, gallery: galleryContent } = podcast;
// Inline background-image with a focus (center/top/bottom/left/right) crop anchor.
const bg = (img, focus) => (img ? `background-image:url('${img}');background-size:cover;background-position:${focus || 'center'};` : undefined);
const { intro1, intro2, bodyA, bodyB } = story;

// ---- Episodes: pulled from the Curiously Polar podcast RSS feed at build time ----
const FEED = 'https://curiouslypolar.com/curiouslypolar/mp3';
const YT_CHANNEL = 'UCxjFCVUKzG3rqlo-TcJoVfA';
const YT_UPLOADS = 'UUxjFCVUKzG3rqlo-TcJoVfA';   // uploads playlist (channel-wide fallback for the lightbox)
const YT_FEED = 'https://www.youtube.com/feeds/videos.xml?channel_id=' + YT_CHANNEL;

// grid slot positions (Figma) — 2 columns; rows 4–5 are revealed by "Load More"
const slots = [
  { l: '0%',     t: '44px'  }, { l: '28.07%', t: '44px'  },
  { l: '0%',     t: '276px' }, { l: '28.07%', t: '276px' },
  { l: '0%',     t: '508px' }, { l: '28.07%', t: '508px' },
  { l: '0%',     t: '740px' }, { l: '28.07%', t: '740px' },
  { l: '0%',     t: '972px' }, { l: '28.07%', t: '972px' },
];

const epNum = (s) => { const m = (s || "").match(/\b(\d{3})\b/); return m ? m[1] : ""; };

let items = [];
try {
  const res = await fetch(FEED, { headers: { 'User-Agent': 'henrypall.com build' } });
  if (res.ok) {
    const xml = await res.text();
    const chImg = (xml.match(/<itunes:image[^>]*href="([^"]+)"/) || [])[1] || "";
    const parts = xml.split('<item>').slice(1, 11);
    items = parts.map((it) => {
      const pick = (re) => { const m = it.match(re); return m ? (m[1] || "").trim() : ""; };
      return {
        title: pick(/<title>\s*(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?\s*<\/title>/),
        audio: pick(/<enclosure[^>]*url="([^"]+)"/),
        cover: pick(/<itunes:image[^>]*href="([^"]+)"/) || chImg,
      };
    });
  }
} catch (e) { /* fall back below */ }

if (!items.length) {
  items = [168, 167, 166, 165, 164, 163, 162, 161, 160, 159].map((n) => ({
    title: 'Curiously Polar #' + n, audio: "",
    cover: 'https://curiouslypolar.com/media/cp' + n + '.jpg',
  }));
}

// map episode number → YouTube video id (for episode-specific "Watch"); falls back to the channel playlist
let vmap = {};
try {
  const r = await fetch(YT_FEED, { headers: { 'User-Agent': 'henrypall.com build' } });
  if (r.ok) {
    const x = await r.text();
    for (const en of x.split('<entry>').slice(1)) {
      const vid = (en.match(/<yt:videoId>([^<]+)<\/yt:videoId>/) || [])[1];
      const num = epNum((en.match(/<title>([^<]*)<\/title>/) || [])[1]);
      if (vid && num && !vmap[num]) vmap[num] = vid;
    }
  }
} catch (e) { /* lightbox falls back to the uploads playlist */ }

const eps = slots.map((s, i) => {
  const it = items[i] || {};
  const num = epNum(it.title);
  // prefer the feed's enclosure; otherwise derive the stable direct-MP3 URL from the episode number
  const audio = it.audio || (num ? `https://curiouslypolar.com/media/cp${num}.mp3` : "");
  return { ...s, ...it, audio, video: vmap[num] || "", extra: i >= 6 };
});

// Team card positions (Figma) merged with editable name/photo content by index.
const teamPos = ['29.77%', '54.01%', '78.52%'];
const team = teamContent.members.map((m, i) => ({ ...m, l: teamPos[i] }));

// Gallery slot positions (Figma) merged with editable photos by index.
const galPos = [
  { l: '64.00%', t: '41px',  w: '37.25%', ar: '418 / 255' },
  { l: '64.44%', t: '337px', w: '14.08%', ar: '1 / 1' },
  { l: '81.73%', t: '337px', w: '18.54%', ar: '208 / 294' },
  { l: '64.44%', t: '536px', w: '14.08%', ar: '158 / 257' },
  { l: '81.73%', t: '672px', w: '18.54%', ar: '208 / 121' },
];
const gallery = galPos.map((g, i) => ({ ...g, ...(galleryContent[i] || {}) }));
---

<BaseLayout title="Curiously Polar — Podcast" description="Curiously Polar — narrating the poles, sharing curiosity. Episodes, the team, and the story behind the podcast.">
  <div class="pod">

    <!-- ============ PODCAST STORY ============ -->
    <section class="pod-sec pod-sec--story">
      <div class="pwrap">
        <div class="canvas canvas--story">
          <span class="wm wm--podcast" aria-hidden="true">PODCAST</span>
          <div class="story__shadow" aria-hidden="true"></div>
          <div class="story__hero placeholder" style={bg(story.heroImage, story.heroFocus)} role="img" aria-label="Curiously Polar hero portrait"></div>
          <h1 class="story__headline" set:html={story.headline}></h1>
          <span class="story__rule" aria-hidden="true"></span>
          <div class="story__intro"><p>{intro1}</p><p>{intro2}</p></div>
          <div class="story__body2"><p>{bodyA}</p><p class="is-last">{bodyB}</p></div>
        </div>
      </div>
    </section>

    <!-- ============ THE TEAM ============ -->
    <section class="pod-sec pod-sec--team">
      <div class="pwrap">
        <div class="canvas canvas--team">
          <span class="wm wm--team" aria-hidden="true">THE TEAM</span>
          <span class="team__line" aria-hidden="true"></span>
          <blockquote class="team__quote">{teamContent.quote}</blockquote>
          {team.map((m) => (
            <figure class="team__card" style={`left:${m.l}`}>
              <div class="team__pic placeholder" style={bg(m.image, m.focus)} role="img" aria-label={m.name}></div>
              <figcaption class="team__name">{m.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ EPISODES + GALLERY ============ -->
    <section class="pod-sec pod-sec--eps">
      <div class="pwrap">
        <div class="canvas canvas--eps">
          <span class="wm wm--eps" aria-hidden="true">EPISODES</span>

          {eps.map((e) => (
            <article class:list={['ep', { 'is-extra': e.extra }]} style={`left:${e.l};top:${e.t}`}>
              <div class="ep__thumb placeholder" style={e.cover ? `background-image:url('${e.cover}')` : undefined} role="img" aria-label={e.title || 'Episode thumbnail'}></div>
              <div class="ep__bar">
                <button class="ep__act ep__act--listen" type="button" data-audio={e.audio} data-title={e.title} data-cover={e.cover} aria-label={e.title ? `Listen — ${e.title}` : 'Listen'}>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>
                  <span>Listen</span>
                </button>
                <button class="ep__act ep__act--watch" type="button" data-video={e.video} aria-label={e.title ? `Watch — ${e.title}` : 'Watch'}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 8.5l6 3.5-6 3.5z" fill="#11292e"/></svg>
                  <span>Watch</span>
                </button>
              </div>
            </article>
          ))}

          <button class="ep-more" id="epMore" type="button">Load More</button>

          {gallery.map((g) => (
            <div class="gal placeholder" style={`left:${g.l};top:${g.t};width:${g.w};aspect-ratio:${g.ar};${bg(g.image, g.focus) || ""}`} role="img" aria-label="Gallery photo"></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FIXED AUDIO PLAYER (loads on "Listen") ============ -->
    <div class="pplayer" id="pplayer" aria-hidden="true">
      <audio id="paudio" preload="none"></audio>
      <div class="pplayer__info">
        <span class="pplayer__thumb" id="pthumb"></span>
        <span class="pplayer__meta">
          <span class="pplayer__show">Curiously Polar</span>
          <span class="pplayer__ep" id="pep"></span>
        </span>
      </div>
      <div class="pplayer__controls">
        <button class="pplayer__btn pplayer__speed" id="pspeed" type="button" aria-label="Playback speed">1x</button>
        <button class="pplayer__btn pplayer__seek" id="pback" type="button" aria-label="Back 15 seconds">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>
          <span class="pplayer__sec">15</span>
        </button>
        <button class="pplayer__play" id="pplay" type="button" aria-label="Play"><span class="pplayer__tri"></span></button>
        <button class="pplayer__btn pplayer__seek" id="pfwd" type="button" aria-label="Forward 60 seconds">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1 -3-6.7"/><path d="M21 4v4h-4"/></svg>
          <span class="pplayer__sec">60</span>
        </button>
        <span class="pplayer__vol">
          <button class="pplayer__btn" id="pmute" type="button" aria-label="Volume">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>
          </button>
          <input class="pplayer__range" id="pvol" type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume level" />
        </span>
      </div>
      <button class="pplayer__close" id="pclose" type="button" aria-label="Close player">&times;</button>
    </div>

    <!-- ============ YOUTUBE LIGHTBOX (opens on "Watch") ============ -->
    <div class="lb" id="lb" aria-hidden="true">
      <div class="lb__frame">
        <button class="lb__close" id="lbclose" type="button" aria-label="Close video">&times;</button>
        <iframe id="lbframe" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen title="Curiously Polar video"></iframe>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .pod { position: relative; overflow-x: clip; padding-bottom: 4rem; }
  .pwrap { position: relative; width: min(1122px, calc(100% - 3rem)); margin-inline: auto; }
  .canvas { position: relative; }

  .wm {
    position: absolute; top: -0.16em; font-family: var(--font); font-weight: 500;
    color: #f5f5f5; white-space: nowrap; line-height: 1; letter-spacing: 0.01em;
    pointer-events: none; user-select: none; z-index: 0;
  }
  .wm--podcast { left: 16.40%; font-size: clamp(88px, 18vw, 200px); }
  .wm--team    { left: -3.03%; font-size: clamp(60px, 13vw, 120px); }
  .wm--eps     { left: -0.18%; font-size: clamp(60px, 13vw, 120px); }

  .pod-sec--story { padding-top: 74px; }
  .pod-sec--team  { margin-top: 97px; }
  .pod-sec--eps   { margin-top: 93px; }

  /* ===================== PODCAST STORY ===================== */
  .canvas--story { height: 983px; }
  .story__shadow { position: absolute; left: -2.41%; top: 57px; width: 44.39%; aspect-ratio: 1 / 1; background: var(--navy); z-index: 0; }
  .story__hero { position: absolute; left: 0.45%; top: 28px; width: 44.39%; aspect-ratio: 1 / 1; z-index: 1; }
  .story__headline {
    position: absolute; left: 39.57%; top: 73px; margin: 0; z-index: 2;
    font-weight: 500; font-size: 40px; line-height: 55px; text-transform: uppercase; color: var(--navy);
  }
  .story__rule { position: absolute; left: 39.57%; top: 203px; width: 98px; height: 2px; background: var(--navy); z-index: 2; }
  .story__intro { position: absolute; left: 52.05%; top: 217px; width: 47.95%; z-index: 2; }
  .story__body2 { position: absolute; left: 21.39%; top: 605px; width: 78.61%; z-index: 2; }
  .story__intro p, .story__body2 p { margin: 0 0 1.1em; font-size: 14px; font-weight: 300; line-height: 1.55; color: #000; }
  .story__intro p:last-child, .story__body2 p.is-last { margin-bottom: 0; }

  /* ===================== THE TEAM ===================== */
  .canvas--team { height: 334px; }
  .team__line { position: absolute; left: -2.50%; top: 110px; width: 2px; height: 101px; background: var(--navy); }
  .team__quote {
    position: absolute; left: 0.27%; top: 113px; width: 22.37%; margin: 0;
    font-size: 16px; font-weight: 400; line-height: 20px; letter-spacing: -0.8px; color: rgba(0,0,0,0.5);
  }
  .team__card { position: absolute; top: 41px; width: 22.73%; margin: 0; }
  .team__pic { width: 100%; aspect-ratio: 1 / 1; }
  .team__name {
    margin: 14px 0 0; font-size: 18px; font-weight: 500; line-height: 24px;
    letter-spacing: -0.9px; color: rgba(0,0,0,0.65); text-transform: uppercase;
  }

  /* ===================== EPISODES + GALLERY ===================== */
  .canvas--eps { height: 793px; }
  .canvas--eps.is-expanded { height: 1200px; }
  .ep { position: absolute; width: 26.74%; }
  .ep.is-extra { display: none; }
  .canvas--eps.is-expanded .ep.is-extra { display: block; }
  .ep__thumb { width: 100%; aspect-ratio: 300 / 169; background-size: cover; background-position: center; }
  .ep__bar { display: flex; align-items: center; height: 35px; background: var(--navy); color: #fff; padding-left: 12px; gap: 45px; }
  .ep__act {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 300; color: #fff;
    background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit;
  }
  .ep__act:hover { opacity: 0.75; }
  .ep__act svg { display: block; }

  .ep-more {
    position: absolute; left: 21.21%; top: 763px; width: 12.03%; height: 30px;
    display: grid; place-items: center;
    background: var(--navy); border: 1px solid #fff; color: #fff; cursor: pointer; font-family: inherit;
    font-size: 12px; font-weight: 500; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .ep-more:hover { background: var(--navy-800); }
  .canvas--eps.is-expanded .ep-more { display: none; }

  .gal { position: absolute; z-index: 1; }

  /* ===================== FIXED AUDIO PLAYER ===================== */
  .pplayer {
    position: fixed; left: 0; right: 0; bottom: 0; height: 75px; z-index: 60;
    background: rgba(9, 22, 25, 0.94); backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    padding: 0 clamp(1rem, 4vw, 3rem); color: #fff;
    transform: translateY(105%); transition: transform 0.32s ease; box-shadow: 0 -8px 30px rgba(0,0,0,0.25);
  }
  .pplayer.is-open { transform: translateY(0); }
  .pplayer__info { position: absolute; left: clamp(1rem, 4vw, 3rem); top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 10px; min-width: 0; max-width: 42%; }
  .pplayer__thumb { flex: 0 0 auto; width: 55px; height: 55px; background: #2b4a52 center/cover no-repeat; }
  .pplayer__meta { display: flex; flex-direction: column; align-items: flex-start; text-align: left; min-width: 0; }
  .pplayer__show { font-size: 14px; font-weight: 300; color: #cdd6da; line-height: 1.3; }
  .pplayer__ep { font-size: 15px; font-weight: 500; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .pplayer__controls { display: flex; align-items: center; gap: clamp(0.7rem, 2.2vw, 1.55rem); }
  .pplayer__btn { position: relative; background: none; border: 0; color: #fff; cursor: pointer; font-family: inherit; font-size: 0.85rem; display: grid; place-items: center; padding: 0; }
  .pplayer__btn:hover { opacity: 0.72; }
  .pplayer__speed { min-width: 30px; font-weight: 500; font-size: 15px; }
  .pplayer__seek { width: 44px; height: 44px; }
  .pplayer__seek svg { width: 44px; height: 44px; }
  .pplayer__sec { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; font-weight: 600; pointer-events: none; }
  .pplayer__play { width: 54px; height: 54px; border-radius: 50%; background: #fff; border: 0; cursor: pointer; display: grid; place-items: center; transition: transform 0.15s ease; }
  .pplayer__play:hover { transform: scale(1.05); }
  .pplayer__tri { width: 0; height: 0; border-left: 15px solid #11292E; border-top: 9px solid transparent; border-bottom: 9px solid transparent; margin-left: 4px; }
  .pplayer__play.is-playing .pplayer__tri { width: 13px; height: 16px; border: 0; margin: 0; border-left: 5px solid #11292E; border-right: 5px solid #11292E; box-sizing: border-box; }
  .pplayer__vol { display: flex; align-items: center; gap: 0.4rem; }
  .pplayer__range { width: 74px; accent-color: #fff; cursor: pointer; }
  .pplayer__close { position: absolute; right: 14px; top: 6px; background: none; border: 0; color: #cdd6da; font-size: 22px; line-height: 1; cursor: pointer; }
  .pplayer__close:hover { color: #fff; }

  /* ===================== YOUTUBE LIGHTBOX ===================== */
  .lb {
    position: fixed; inset: 0; z-index: 70; display: none; align-items: center; justify-content: center;
    background: rgba(6, 14, 16, 0.86); padding: 1.5rem;
  }
  .lb.is-open { display: flex; }
  .lb__frame { position: relative; width: min(960px, 100%); aspect-ratio: 16 / 9; background: #000; box-shadow: 0 24px 70px rgba(0,0,0,0.55); }
  .lb__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .lb__close { position: absolute; top: -42px; right: 0; background: none; border: 0; color: #fff; font-size: 30px; line-height: 1; cursor: pointer; }
  .lb__close:hover { opacity: 0.75; }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 920px) {
    .canvas--story, .canvas--team, .canvas--eps, .canvas--eps.is-expanded { height: auto; }
    .wm { position: static; display: block; margin-bottom: -0.35em; }
    .story__shadow { display: none; }
    .story__hero { position: static; width: 100%; max-width: 420px; margin: 0 auto 2rem; }
    .story__headline { position: static; margin: 0 0 1rem; font-size: clamp(28px, 7vw, 40px); line-height: 1.2; }
    .story__rule { position: static; margin: 0 0 1.4rem; }
    .story__intro, .story__body2 { position: static; width: 100%; margin: 0 0 1.6rem; }
    .team__line { display: none; }
    .team__quote { position: static; width: 100%; max-width: 460px; margin: 0 0 2rem; font-size: 17px; line-height: 1.5; }
    .team__card { position: static; width: 100%; max-width: 320px; margin: 0 auto 2rem; }
    .ep { position: static; width: 100%; max-width: 420px; margin: 0 auto 1.6rem; }
    .ep-more { position: static; width: 160px; height: 40px; margin: 0.5rem auto 3rem; }
    .gal { position: static; width: 100% !important; max-width: 420px; margin: 0 auto 1rem; aspect-ratio: 4 / 3 !important; }
    .pplayer { height: auto; flex-direction: column; gap: 10px; padding: 12px 1rem 14px; }
    .pplayer__info { position: static; transform: none; max-width: 100%; }
    .pplayer__controls { gap: 0.9rem; }
    .pplayer__vol .pplayer__range { display: none; }
  }
</style>

<script define:vars={{ YT_UPLOADS }}>
  (function () {
    // ---- fixed audio player ----
    const player = document.getElementById('pplayer');
    const audio = document.getElementById('paudio');
    const play = document.getElementById('pplay');
    const speed = document.getElementById('pspeed');
    const back = document.getElementById('pback');
    const fwd = document.getElementById('pfwd');
    const mute = document.getElementById('pmute');
    const vol = document.getElementById('pvol');
    const thumb = document.getElementById('pthumb');
    const epEl = document.getElementById('pep');
    const closeBtn = document.getElementById('pclose');

    document.querySelectorAll('.ep__act--listen').forEach((b) => {
      b.addEventListener('click', () => {
        const a = b.dataset.audio;
        if (!a) return;
        if (audio.getAttribute('src') !== a) audio.src = a;
        thumb.style.backgroundImage = b.dataset.cover ? `url('${b.dataset.cover}')` : "";
        epEl.textContent = b.dataset.title || "";
        player.classList.add('is-open');
        player.setAttribute('aria-hidden', 'false');
        audio.play();
      });
    });
    play && play.addEventListener('click', () => { audio.paused ? audio.play() : audio.pause(); });
    audio.addEventListener('play', () => { play.classList.add('is-playing'); play.setAttribute('aria-label', 'Pause'); });
    audio.addEventListener('pause', () => { play.classList.remove('is-playing'); play.setAttribute('aria-label', 'Play'); });
    const rates = [0.8, 1, 1.5, 2]; let ri = 1;
    speed && speed.addEventListener('click', () => { ri = (ri + 1) % rates.length; audio.playbackRate = rates[ri]; speed.textContent = rates[ri] + 'x'; });
    back && back.addEventListener('click', () => { audio.currentTime = Math.max(0, audio.currentTime - 15); });
    fwd && fwd.addEventListener('click', () => { audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 60); });
    vol && vol.addEventListener('input', () => { audio.volume = parseFloat(vol.value); audio.muted = audio.volume === 0; });
    mute && mute.addEventListener('click', () => { audio.muted = !audio.muted; vol.value = audio.muted ? 0 : (audio.volume || 1); });
    closeBtn && closeBtn.addEventListener('click', () => { audio.pause(); player.classList.remove('is-open'); player.setAttribute('aria-hidden', 'true'); });

    // ---- youtube lightbox ----
    const lb = document.getElementById('lb');
    const lbframe = document.getElementById('lbframe');
    const lbclose = document.getElementById('lbclose');
    function openLB(video) {
      lbframe.src = video
        ? `https://www.youtube-nocookie.com/embed/${video}?autoplay=1&rel=0`
        : `https://www.youtube-nocookie.com/embed/videoseries?list=${YT_UPLOADS}&autoplay=1`;
      lb.classList.add('is-open'); lb.setAttribute('aria-hidden', 'false');
    }
    function closeLB() { lbframe.src = ""; lb.classList.remove('is-open'); lb.setAttribute('aria-hidden', 'true'); }
    document.querySelectorAll('.ep__act--watch').forEach((b) => {
      b.addEventListener('click', () => openLB(b.dataset.video));
    });
    lbclose && lbclose.addEventListener('click', closeLB);
    lb && lb.addEventListener('click', (e) => { if (e.target === lb) closeLB(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLB(); });

    // ---- load more (reveal rows 4–5) ----
    const more = document.getElementById('epMore');
    const epsCanvas = document.querySelector('.canvas--eps');
    more && more.addEventListener('click', () => { epsCanvas.classList.add('is-expanded'); });
  })();
</script>
