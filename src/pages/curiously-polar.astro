---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <!-- ============ TOP THIRD — HERO ============ -->
  <section class="cphero">
    <div class="cphero__body">
      <p class="cphero__eyebrow">Curiously Polar</p>
      <p class="cphero__line">Let’s explore together</p>
      <p class="cphero__line">the magnificent polar regions</p>
      <div class="cphero__actions">
        <a class="cpbtn cpbtn--solid" href="#">The Podcast</a>
        <a class="cpbtn cpbtn--ghost" href="#">Monthly Email</a>
      </div>
    </div>

    <!-- Podcast playback bar -->
    <div class="cpplayer">
      <div class="cpplayer__info">
        <span class="cpplayer__thumb"></span>
        <span class="cpplayer__meta">
          <span class="cpplayer__show">Curiously Polar</span>
          <span class="cpplayer__ep">168 · Scramble for the North Pole</span>
        </span>
      </div>
      <div class="cpplayer__controls">
        <button class="cpplayer__btn" type="button" aria-label="Playback speed">1x</button>
        <button class="cpplayer__btn" type="button" aria-label="Back 15 seconds">↺15</button>
        <button class="cpplayer__play" type="button" aria-label="Play"><span></span></button>
        <button class="cpplayer__btn" type="button" aria-label="Forward 60 seconds">60↻</button>
        <button class="cpplayer__btn" type="button" aria-label="Volume">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ MIDDLE THIRD — PODCAST / QUOTES ============ -->
  <section class="cpmid">
    <div class="wrap cpmid__inner">
      <div class="cpmid__img placeholder"></div>

      <blockquote class="cpmid__quote">
        <p>It’s our very own curiosity that’s our key driver. We want to learn, understand, and share about the most remote, most fragile ecosystems on our planet.</p>
        <a class="cpbtn cpbtn--solid cpmid__more" href="#"><span class="cpbtn__bar">|</span> <b>Read</b> More</a>
      </blockquote>

      <figure class="cpmotto">
        <span class="cpmotto__mark cpmotto__mark--open">“</span>
        <blockquote>In the end, we will conserve only what we love, we will love only what we understand, and we will understand only what we are taught.</blockquote>
        <figcaption>Baba Dioum</figcaption>
        <span class="cpmotto__mark cpmotto__mark--close">”</span>
      </figure>
    </div>
  </section>

  <!-- ============ BOTTOM THIRD — NEWSLETTER ============ -->
  <section class="cpnews-outer">
    <div class="wrap cpnews">
      <p class="cpnews__eyebrow"><span>Narrating the Poles</span></p>
      <h2 class="cpnews__title">Sign up for your<br /><span class="cpnews__hl">monthly dose</span><br />of polar <span class="cpnews__hl">curiosity</span></h2>
      <p class="cpnews__sub">Stay up to date with our monthly reminders of how awesome, precious and fun the polar regions are.</p>
      <form class="cpnews__form" onsubmit="return false">
        <input type="text" placeholder="Your Name" aria-label="Your Name" />
        <input type="email" placeholder="Your Email" aria-label="Your Email" />
        <button class="cpnews__join" type="submit">Join Now</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { position: relative; width: min(1104px, calc(100% - 2.5rem)); margin-inline: auto; }

  /* shared buttons */
  .cpbtn {
    display: inline-block; padding: 0.6rem 1.4rem; font-size: 0.9rem; letter-spacing: 0.02em;
    border: 1px solid #fff; white-space: nowrap; transition: background 0.18s ease, color 0.18s ease;
  }
  .cpbtn--solid { background: #fff; color: var(--navy); }
  .cpbtn--solid:hover { background: transparent; color: #fff; }
  .cpbtn--ghost { background: transparent; color: #fff; }
  .cpbtn--ghost:hover { background: #fff; color: var(--navy); }

  /* ---------- HERO (full-bleed) ---------- */
  .cphero {
    position: relative; background: var(--navy); color: #fff;
    min-height: 82vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 5rem 1.5rem 7rem; text-align: center; overflow: hidden;
  }
  .cphero__body { position: relative; z-index: 1; }
  .cphero__eyebrow { text-transform: uppercase; letter-spacing: 0.22em; font-weight: 300; font-size: 20px; margin: 0 0 1.4rem; }
  .cphero__line { font-weight: 400; font-size: clamp(1.9rem, 4.6vw, 50px); line-height: 1.12; margin: 0; }
  .cphero__actions { margin-top: 2.4rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* podcast player bar */
  .cpplayer {
    position: absolute; left: 0; right: 0; bottom: 0; height: 75px; z-index: 2;
    background: rgba(0, 0, 0, 0.35); backdrop-filter: blur(2px);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 clamp(1rem, 4vw, 3rem); color: #fff;
  }
  .cpplayer__info { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .cpplayer__thumb { flex: 0 0 auto; width: 55px; height: 55px; background: #2b4a52; }
  .cpplayer__meta { display: flex; flex-direction: column; min-width: 0; }
  .cpplayer__show { font-size: 0.8rem; color: #b9c4c9; }
  .cpplayer__ep { font-size: 0.95rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cpplayer__controls { display: flex; align-items: center; gap: clamp(0.8rem, 2.5vw, 1.8rem); }
  .cpplayer__btn { background: none; border: 0; color: #fff; cursor: pointer; font-family: inherit; font-size: 0.85rem; display: grid; place-items: center; }
  .cpplayer__btn:hover { opacity: 0.7; }
  .cpplayer__play { width: 52px; height: 52px; border-radius: 50%; background: #fff; border: 0; cursor: pointer; display: grid; place-items: center; }
  .cpplayer__play span { width: 0; height: 0; border-left: 14px solid var(--navy); border-top: 9px solid transparent; border-bottom: 9px solid transparent; margin-left: 3px; }
  .cpplayer__play:hover { transform: scale(1.05); }

  /* ---------- MIDDLE (image + quote card + motto) ---------- */
  .cpmid { padding: 4.5rem 0 4rem; }
  .cpmid__inner { position: relative; min-height: 760px; }
  .cpmid__img { margin-left: 24.2%; width: 66.85%; aspect-ratio: 1 / 1; background: var(--placeholder); }
  .cpmid__quote {
    position: absolute; left: 0; top: 74px; width: 46.34%; margin: 0;
    background: #fff; box-shadow: 0 24px 60px rgba(17, 41, 46, 0.16);
    border-left: 2px solid var(--navy);
    padding: 3rem 3rem 2.6rem;
  }
  .cpmid__quote p { margin: 0 0 1.8rem; font-size: 1.05rem; font-weight: 300; line-height: 1.7; color: #1a2a2f; }
  .cpmid__more { display: inline-flex; align-items: center; gap: 4px; }
  .cpbtn__bar { font-weight: 300; }
  .cpmid__more b { font-weight: 600; }

  .cpmotto {
    position: absolute; left: 53.62%; top: 585px; width: 41.09%; margin: 0;
    background: var(--navy); color: #fff; padding: 3rem 3rem 2.4rem;
  }
  .cpmotto blockquote { margin: 0; font-size: 1rem; font-weight: 300; line-height: 1.7; }
  .cpmotto figcaption { margin-top: 1.4rem; text-align: right; font-size: 0.85rem; font-style: italic; color: #c7d0d4; }
  .cpmotto__mark { position: absolute; font-size: 5rem; line-height: 1; color: #fff; font-family: Georgia, serif; }
  .cpmotto__mark--open { top: 0.4rem; left: 1.4rem; }
  .cpmotto__mark--close { bottom: -1.6rem; right: 1.4rem; }

  /* ---------- NEWSLETTER ---------- */
  .cpnews-outer { padding: 3rem 0 4rem; }
  .cpnews { background: var(--navy); color: #fff; text-align: center; padding: clamp(3rem, 6vw, 5rem) 1.5rem; }
  .cpnews__eyebrow {
    display: flex; align-items: center; gap: 1.2rem; justify-content: center;
    text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.78rem; color: #cdd6da; margin: 0 0 2rem;
  }
  .cpnews__eyebrow::before, .cpnews__eyebrow::after { content: ''; height: 1px; background: rgba(255,255,255,0.35); flex: 1; max-width: 240px; }
  .cpnews__title { color: #fff; margin: 0 0 1.6rem; font-weight: 500; text-transform: uppercase; font-size: clamp(2rem, 5vw, 52px); line-height: 1.08; letter-spacing: 0.01em; }
  .cpnews__hl { position: relative; white-space: nowrap; }
  .cpnews__hl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.08em; height: 0.18em; background: rgba(255,255,255,0.22); z-index: -1; }
  .cpnews__sub { max-width: 560px; margin: 0 auto 2.4rem; font-size: 0.95rem; font-weight: 300; line-height: 1.6; color: #cdd6da; }
  .cpnews__form { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  .cpnews__form input {
    width: 300px; max-width: 100%; height: 44px; padding: 0 1.1rem; border: 0; border-radius: 2px;
    font-family: inherit; font-size: 0.85rem; background: #fff; color: #111;
  }
  .cpnews__join {
    height: 44px; padding: 0 1.6rem; border: 0; background: #7fb2c7; color: var(--navy);
    font-family: inherit; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;
    font-size: 0.78rem; cursor: pointer; border-radius: 2px;
  }
  .cpnews__join:hover { background: #6aa3ba; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 820px) {
    .cphero { min-height: 70vh; }
    .cpmid__inner { min-height: 0; }
    .cpmid__img { margin-left: 0; width: 100%; }
    .cpmid__quote { position: static; width: 90%; margin: -3rem 0 2rem; }
    .cpmotto { position: static; width: 100%; }
    .cpmotto__mark--close { bottom: 0.4rem; }
  }
  @media (max-width: 560px) {
    .cpplayer__ep { max-width: 120px; }
    .cpplayer__controls { gap: 0.7rem; }
  }
</style>
