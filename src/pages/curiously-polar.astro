---
import BaseLayout from '../layouts/BaseLayout.astro';
import cp from '../content/curiously-polar.json';

const base = import.meta.env.BASE_URL.replace(/\/+$/, ""); // "/beta"
const FEED = 'https://curiouslypolar.com/curiouslypolar/mp3';

const { hero, middle, newsletter } = cp;
// Inline background-image with a focus (center/top/bottom/left/right) crop anchor.
const bg = (img, focus) => (img ? `background-image:url('${img}');background-size:cover;background-position:${focus || 'center'};` : undefined);
// Split a button label so the first word is bold (matches the "| **Read** More" style).
const splitLabel = (s) => { const t = String(s); const i = t.indexOf(' '); const first = i < 0 ? t : t.slice(0, i); const rest = i < 0 ? t.slice(t.length) : t.slice(i + 1); return { first, rest }; };
const more = splitLabel(middle.moreLabel);

// --- Latest episode, pulled from the podcast RSS feed at build time. ---
// Falls back to the last-known episode if the feed can't be reached during the build.
let episode = {
  show: 'Curiously Polar',
  title: '168 Scramble for the North Pole',
  audio: 'https://feedpress.me/link/17484/16152061/cp168.mp3',
  cover: 'https://curiouslypolar.com/media/cp168.jpg',
};

try {
  const res = await fetch(FEED, { headers: { 'User-Agent': 'henrypall.com build' } });
  if (res.ok) {
    const xml = await res.text();
    const chTitle = xml.match(/<channel>[\s\S]*?<title>\s*(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?\s*<\/title>/);
    const chImg = xml.match(/<itunes:image[^>]*href="([^"]+)"/);
    const item = xml.split('<item>')[1] || "";
    const pick = (re) => { const m = item.match(re); return m ? (m[1] || "").trim() : ""; };
    const title = pick(/<title>\s*(?:<!\[CDATA\[)?([\s\S]*?)(?:\]\]>)?\s*<\/title>/);
    const audio = pick(/<enclosure[^>]*url="([^"]+)"/);
    const cover = pick(/<itunes:image[^>]*href="([^"]+)"/);
    if (chTitle && chTitle[1]) episode.show = chTitle[1];
    if (title) episode.title = title;
    if (audio) episode.audio = audio;
    if (cover) episode.cover = cover;
    else if (chImg) episode.cover = chImg[1];
  }
} catch (e) {
  // keep fallback episode
}
---

<BaseLayout overlayHeader>
  <!-- ============ TOP THIRD — HERO ============ -->
  <section class="cphero">
    <div class="cphero__bg" style={bg(hero.backgroundImage, hero.backgroundFocus)}></div>
    <div class="cphero__scrim"></div>

    <div class="cphero__body">
      <p class="cphero__eyebrow">{hero.eyebrow}</p>
      <p class="cphero__line">{hero.line1}</p>
      <p class="cphero__line">{hero.line2}</p>
      <div class="cphero__actions">
        {hero.buttons.map((b) => (
          <a class="cpbtn" href={b.link}>{b.label}</a>
        ))}
      </div>
    </div>

    <!-- Podcast playback bar (pulls the latest episode from the RSS feed) -->
    <div class="cpplayer" id="cpplayer" data-audio={episode.audio}>
      <audio id="cpaudio" preload="none" src={episode.audio}></audio>
      <div class="cpplayer__info">
        <span class="cpplayer__thumb" style={`background-image:url('${episode.cover}')`}></span>
        <span class="cpplayer__meta">
          <span class="cpplayer__show">{episode.show}</span>
          <span class="cpplayer__ep">{episode.title}</span>
        </span>
      </div>
      <div class="cpplayer__controls">
        <button class="cpplayer__btn cpplayer__speed" id="cpspeed" type="button" aria-label="Playback speed">1x</button>
        <button class="cpplayer__btn cpplayer__seek" id="cpback" type="button" aria-label="Back 15 seconds">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>
          <span class="cpplayer__sec">15</span>
        </button>
        <button class="cpplayer__play" id="cpplay" type="button" aria-label="Play"><span class="cpplayer__tri"></span></button>
        <button class="cpplayer__btn cpplayer__seek" id="cpfwd" type="button" aria-label="Forward 60 seconds">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1 -3-6.7"/><path d="M21 4v4h-4"/></svg>
          <span class="cpplayer__sec">60</span>
        </button>
        <span class="cpplayer__vol">
          <button class="cpplayer__btn" id="cpmute" type="button" aria-label="Volume">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9v6h4l5 4V5L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>
          </button>
          <input class="cpplayer__range" id="cpvol" type="range" min="0" max="1" step="0.05" value="1" aria-label="Volume level" />
        </span>
      </div>
    </div>
  </section>

  <!-- ============ MIDDLE THIRD — PODCAST / QUOTES ============ -->
  <section class="cpmid">
    <div class="wrap cpmid__inner">
      <div class="cpmid__img" style={bg(middle.image, middle.focus)}></div>

      <blockquote class="cpmid__quote">
        <p class="cpmid__qtext">{middle.quote}</p>
        <a class="cpmid__more" href={middle.moreLink}><span class="cpmid__bar">|</span> <b>{more.first}</b> {more.rest}</a>
      </blockquote>

      <figure class="cpmotto">
        <span class="cpmotto__mark cpmotto__mark--open">“</span>
        <span class="cpmotto__line cpmotto__line--1"></span>
        <blockquote class="cpmotto__text" set:html={middle.motto}></blockquote>
        <span class="cpmotto__line cpmotto__line--2"></span>
        <figcaption>{middle.mottoAuthor}</figcaption>
        <span class="cpmotto__mark cpmotto__mark--close">“</span>
      </figure>
    </div>
  </section>

  <!-- ============ BOTTOM THIRD — NEWSLETTER ============ -->
  <section class="cpnews-outer" id="cpnews">
    <div class="wrap cpnews">
      <div class="cpnews__block">
        <p class="cpnews__eyebrow"><span>{newsletter.eyebrow}</span></p>
        <h2 class="cpnews__title">
          <span class="cpnews__l cpnews__l1" set:html={newsletter.titleLine1}></span>
          <span class="cpnews__l cpnews__l2" set:html={newsletter.titleLine2}></span>
          <span class="cpnews__l cpnews__l3" set:html={newsletter.titleLine3}></span>
        </h2>
        <p class="cpnews__sub">{newsletter.sub}</p>
        <form class="cpnews__form" action="#" method="post" onsubmit="return false">
          <input type="text" name="cm-name" placeholder="Your Name" aria-label="Your Name" />
          <input type="email" name="cm-email" placeholder="Your Email" aria-label="Your Email" />
          <button class="cpnews__join" type="submit">{newsletter.joinLabel}</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { position: relative; width: min(1104px, calc(100% - 2.5rem)); margin-inline: auto; }

  /* ---------- HERO (full-bleed grey plate, runs behind the transparent header) ---------- */
  .cphero {
    position: relative; color: #fff;
    min-height: 88vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 8rem 1.5rem 7rem; text-align: center; overflow: hidden;
  }
  /* grey placeholder image plate — same grey as every other placeholder */
  .cphero__bg { position: absolute; inset: 0; background: var(--placeholder); background-size: cover; background-position: center; z-index: 0; }
  /* neutral grey darkening (NOT navy) so white text stays legible without tinting the plate green */
  .cphero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(30,30,30,0.30) 0%, rgba(30,30,30,0.22) 45%, rgba(30,30,30,0.40) 100%);
  }
  .cphero__body { position: relative; z-index: 2; text-shadow: 0 1px 18px rgba(0,0,0,0.35); }
  .cphero__eyebrow { text-transform: uppercase; letter-spacing: 0.22em; font-weight: 300; font-size: 20px; margin: 0 0 1.4rem; }
  .cphero__line { font-weight: 400; font-size: clamp(1.9rem, 4.6vw, 50px); line-height: 1.12; margin: 0; }
  .cphero__actions { margin-top: 2.4rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; text-shadow: none; }

  /* both buttons: #11292E fill, white type */
  .cpbtn {
    display: inline-block; padding: 0.72rem 1.7rem; font-size: 0.9rem; letter-spacing: 0.02em;
    background: #11292E; color: #fff; border: 1px solid #11292E; white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .cpbtn:hover { background: transparent; color: #fff; }

  /* ---------- podcast player bar (functional) ---------- */
  .cpplayer {
    position: absolute; left: 0; right: 0; bottom: 0; height: 75px; z-index: 3;
    background: rgba(9, 22, 25, 0.55); backdrop-filter: blur(3px);
    display: flex; align-items: center; justify-content: center;
    padding: 0 clamp(1rem, 4vw, 3rem); color: #fff;
  }
  .cpplayer__info { position: absolute; left: clamp(1rem, 4vw, 3rem); top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 10px; min-width: 0; max-width: 42%; }
  .cpplayer__thumb { flex: 0 0 auto; width: 55px; height: 55px; background: #2b4a52 center/cover no-repeat; }
  /* episode information left-aligned toward the thumbnail */
  .cpplayer__meta { display: flex; flex-direction: column; align-items: flex-start; text-align: left; min-width: 0; }
  .cpplayer__show { font-size: 14px; font-weight: 300; color: #cdd6da; line-height: 1.3; }
  .cpplayer__ep { font-size: 15px; font-weight: 500; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .cpplayer__controls { display: flex; align-items: center; gap: clamp(0.7rem, 2.2vw, 1.55rem); }
  .cpplayer__btn { position: relative; background: none; border: 0; color: #fff; cursor: pointer; font-family: inherit; font-size: 0.85rem; display: grid; place-items: center; padding: 0; }
  .cpplayer__btn:hover { opacity: 0.72; }
  .cpplayer__speed { min-width: 30px; font-weight: 500; font-size: 15px; }
  /* larger circular-arrow seek buttons with the number centred inside */
  .cpplayer__seek { width: 44px; height: 44px; }
  .cpplayer__seek svg { width: 44px; height: 44px; }
  .cpplayer__sec { position: absolute; inset: 0; display: grid; place-items: center; font-size: 12px; font-weight: 600; pointer-events: none; }
  .cpplayer__play { width: 60px; height: 60px; border-radius: 50%; background: #fff; border: 0; cursor: pointer; display: grid; place-items: center; transition: transform 0.15s ease; }
  .cpplayer__tri { width: 0; height: 0; border-left: 16px solid #11292E; border-top: 10px solid transparent; border-bottom: 10px solid transparent; margin-left: 4px; }
  .cpplayer__play.is-playing .cpplayer__tri {
    width: 14px; height: 17px; border: 0; margin: 0;
    border-left: 5px solid #11292E; border-right: 5px solid #11292E;
    box-sizing: border-box;
  }
  .cpplayer__play:hover { transform: scale(1.05); }
  .cpplayer__vol { display: flex; align-items: center; gap: 0.4rem; }
  .cpplayer__range { width: 0; opacity: 0; transition: width 0.2s ease, opacity 0.2s ease; accent-color: #fff; cursor: pointer; }
  .cpplayer__vol:hover .cpplayer__range, .cpplayer__range:focus { width: 74px; opacity: 1; }

  /* ---------- MIDDLE (image + quote card + motto) ---------- */
  .cpmid { padding: 4.5rem 0 4rem; }
  .cpmid__inner { position: relative; min-height: 760px; }
  .cpmid__img { margin-left: 24.24%; width: 66.84%; aspect-ratio: 1 / 1; background: var(--placeholder); }

  /* quote card 520×324 in Figma → padding 52 / 40 / 47 / 65 */
  .cpmid__quote {
    position: absolute; left: 0; top: 74px; width: 46.35%; margin: 0;
    background: #fff; box-shadow: 0 24px 60px rgba(17, 41, 46, 0.16);
    padding: 52px 40px 47px 65px;
  }
  .cpmid__qtext { position: relative; margin: 0; font-size: 16px; font-weight: 300; font-style: italic; line-height: 1.72; color: #1a2a2f; }
  /* vertical rule spans EXACTLY the height of the quote text, offset 31px to its left */
  .cpmid__qtext::before { content: ""; position: absolute; left: -31px; top: 0; bottom: 0; width: 2px; background: var(--navy); }
  .cpmid__more { display: inline-block; margin-top: 20px; width: 128px; height: 40px; line-height: 40px; text-align: center; background: var(--navy); color: #fff; font-size: 14px; white-space: nowrap; }
  .cpmid__more:hover { background: var(--navy-800); }
  .cpmid__bar { font-weight: 300; }
  .cpmid__more b { font-weight: 600; }

  /* motto — navy card 461×205, exact element positions from Figma (as % of the card) */
  .cpmotto {
    position: absolute; left: 53.57%; top: 585px; width: 41.09%; aspect-ratio: 461 / 205; margin: 0;
    background: var(--navy); color: #fff;
  }
  .cpmotto__text {
    position: absolute; left: 11.28%; top: 33.66%; width: 77.0%; margin: 0;
    text-align: center; font-size: 15px; font-style: italic; font-weight: 300; line-height: 1.55; white-space: nowrap;
  }
  .cpmotto figcaption {
    position: absolute; left: 67.03%; top: 76.6%; white-space: nowrap;
    text-align: left; font-size: 10px; letter-spacing: 0.02em; color: #dfe5e8;
  }
  .cpmotto__mark { position: absolute; font-family: 'Port Lligat Slab', Georgia, serif; font-size: 75px; line-height: 1; color: #fff; }
  .cpmotto__mark--open { left: 9.54%; top: 11.7%; }
  .cpmotto__mark--close { left: 89.4%; top: 91.7%; transform: rotate(180deg); transform-origin: left top; }
  .cpmotto__line { position: absolute; height: 2px; background: #fff; }
  .cpmotto__line--1 { left: 19.52%; top: 23.9%; width: 68.76%; }
  .cpmotto__line--2 { left: 11.28%; top: 80.49%; width: 52.5%; }

  /* ---------- NEWSLETTER (grey plate; content block anchored bottom-right) ---------- */
  .cpnews-outer { padding: 3rem 0 4.5rem; scroll-margin-top: 90px; }
  .cpnews { position: relative; background: var(--placeholder); aspect-ratio: 1122 / 680; color: #11292E; }
  .cpnews__block {
    position: absolute; right: 3.92%; bottom: 6.62%; width: 66.13%;
    display: flex; flex-direction: column;
  }

  /* eyebrow: centred label over a continuous full-width rule, white knock-out behind the text */
  .cpnews__eyebrow { position: relative; isolation: isolate; text-align: center; margin: 0 0 18px; }
  /* continuous full-width rule — text sits ~3px above it */
  .cpnews__eyebrow::before { content: ""; position: absolute; left: 0; right: 0; top: calc(50% + 3px); height: 1px; background: rgba(17,41,46,0.55); z-index: 0; }
  .cpnews__eyebrow span {
    position: relative; padding: 0 2px;
    text-transform: uppercase; letter-spacing: 0.22em; font-size: 12px; color: #11292E;
  }
  /* white rectangle sits BEHIND both the rule and the text (interrupts neither):
     offset 3px left / 2px beyond text right, 6px down from the top, reaching 3px below the rule */
  .cpnews__eyebrow span::before {
    content: ""; position: absolute; z-index: -1; left: -3px; right: -2px; top: 6px; bottom: -6px; background: #fff;
  }

  /* staggered headline, 50px SemiBold, indents from Figma */
  .cpnews__title { margin: 0 0 22px; font-weight: 600; text-transform: uppercase; font-size: clamp(2rem, 4.6vw, 50px); line-height: 1.1; letter-spacing: 0.01em; }
  .cpnews__l { display: block; text-align: left; white-space: nowrap; }
  .cpnews__l1 { padding-left: 22.1%; }
  .cpnews__l2 { padding-left: 0.5%; }
  .cpnews__l3 { padding-left: 21.8%; }
  /* white highlight bars behind the words (under "Sign up" and "polar curiosity") */
  .cpnews__hl { position: relative; z-index: 0; }
  .cpnews__hl::before {
    content: ""; position: absolute; left: -0.1em; right: -0.1em; bottom: 0.12em; height: 0.3em;
    background: #fff; z-index: -1;
  }

  .cpnews__sub { max-width: 73%; margin: 0 auto 30px; font-size: clamp(1rem, 1.7vw, 18px); font-weight: 400; line-height: 1.45; text-align: center; color: #11292E; }

  .cpnews__form { display: flex; gap: 17px; justify-content: space-between; }
  .cpnews__form input {
    flex: 1 1 0; min-width: 0; height: 44px; padding: 0 1rem; border: 0; border-radius: 6px;
    font-family: inherit; font-size: 0.9rem; background: #fff; color: #11292E; text-align: center;
  }
  .cpnews__form input::placeholder { color: rgba(0,0,0,0.35); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  .cpnews__join {
    flex: 0 0 auto; height: 44px; padding: 0 1.6rem; border: 0; background: #11292E; color: #fff;
    font-family: inherit; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;
    font-size: 14px; cursor: pointer; border-radius: 6px;
  }
  .cpnews__join:hover { background: var(--navy-800); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 820px) {
    .cphero { min-height: 74vh; }
    .cpmid__inner { min-height: 0; }
    .cpmid__img { margin-left: 0; width: 100%; }
    .cpmid__quote { position: static; width: 90%; margin: -3rem 0 2rem; }
    .cpmotto { position: static; width: 100%; aspect-ratio: auto; padding: 46px 40px 40px; margin-top: 1.5rem; }
    .cpmotto__text { position: static; width: auto; white-space: normal; }
    .cpmotto figcaption { position: static; width: auto; text-align: center; margin-top: 1rem; }
    .cpmotto__line { display: none; }
    .cpmotto__mark--open { top: 14px; left: 18px; }
    .cpmotto__mark--close { top: auto; bottom: 6px; left: auto; right: 22px; transform: rotate(180deg); }
    .cpnews { aspect-ratio: auto; }
    .cpnews__block { position: static; width: auto; padding: clamp(2.5rem, 6vw, 4rem) 1.5rem; }
    .cpnews__l { white-space: normal; text-align: center; padding-left: 0; }
    .cpnews__sub { max-width: 100%; }
    .cpnews__form { flex-wrap: wrap; justify-content: center; }
    .cpnews__form input { flex: 1 1 240px; }
  }
  @media (max-width: 560px) {
    .cpplayer__ep { max-width: 120px; }
    .cpplayer__controls { gap: 0.6rem; }
    .cpplayer__vol .cpplayer__range { display: none; }
  }
</style>

<script>
  (function () {
    const audio = document.getElementById('cpaudio');
    const play = document.getElementById('cpplay');
    const speed = document.getElementById('cpspeed');
    const back = document.getElementById('cpback');
    const fwd = document.getElementById('cpfwd');
    const mute = document.getElementById('cpmute');
    const vol = document.getElementById('cpvol');
    if (!audio) return;

    play && play.addEventListener('click', function () {
      if (audio.paused) { audio.play(); } else { audio.pause(); }
    });
    audio.addEventListener('play', function () {
      play.classList.add('is-playing'); play.setAttribute('aria-label', 'Pause');
    });
    audio.addEventListener('pause', function () {
      play.classList.remove('is-playing'); play.setAttribute('aria-label', 'Play');
    });

    const rates = [0.8, 1, 1.5, 2];
    let ri = 1; // default 1x
    speed && speed.addEventListener('click', function () {
      ri = (ri + 1) % rates.length;
      audio.playbackRate = rates[ri];
      speed.textContent = rates[ri] + 'x';
    });

    back && back.addEventListener('click', function () {
      audio.currentTime = Math.max(0, audio.currentTime - 15);
    });
    fwd && fwd.addEventListener('click', function () {
      audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 60);
    });

    vol && vol.addEventListener('input', function () {
      audio.volume = parseFloat(vol.value);
      audio.muted = audio.volume === 0;
    });
    mute && mute.addEventListener('click', function () {
      audio.muted = !audio.muted;
      vol.value = audio.muted ? 0 : (audio.volume || 1);
    });
  })();
</script>
