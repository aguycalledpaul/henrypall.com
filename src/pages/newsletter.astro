---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, ''); // "/beta"

// Editions live in src/newsletters/<list>/<YYYY-MM-DD>.md — drop a new dated file
// into a folder (or add one via the CMS) and it appears here automatically, newest first.
const THUMB_POS = ['28.96%', '53.06%', '77.41%']; // Figma thumbnail x-positions in the bottom band

function loadEditions(globbed) {
  return Object.entries(globbed)
    .map(([path, mod]) => {
      const slug = path.split('/').pop().replace(/\.md$/, '');
      const fm = (mod && mod.frontmatter) || {};
      return {
        iso: fm.date || slug,
        date: fm.displayDate || slug,
        title: fm.title || 'Untitled edition',
        cover: fm.cover || '',
      };
    })
    .sort((a, b) => (a.iso < b.iso ? 1 : -1));
}

const journal = loadEditions(import.meta.glob('../newsletters/journal/*.md', { eager: true })).slice(0, 3);
const cpNews = loadEditions(import.meta.glob('../newsletters/narrating-the-poles/*.md', { eager: true }))
  .slice(0, 3)
  .map((n, i) => ({ ...n, l: THUMB_POS[i] }));
---

<BaseLayout title="Newsletter — Henry Páll Wulff" description="Subscribe to Henry Páll Wulff's journal and the Curiously Polar monthly newsletter — content from the polar regions, inspiration, tips and exclusive offers.">
  <div class="nl">

    <!-- ============ TOP: journal cards (left) + signup forms (right) ============ -->
    <section class="nlwrap nl-top">
      <div class="nl-left">
        {journal.map((j) => (
          <article class="nlcard">
            <div class="nlcard__img placeholder" role="img" aria-label="Journal header image"></div>
            <div class="nlcard__foot">
              <div class="nlcard__meta">
                <p class="nlcard__date">{j.date}</p>
                <h3 class="nlcard__title">{j.title}</h3>
              </div>
              <a class="nlcard__btn" href="#"><span class="nlcard__bar">|</span> <b>Read</b> More</a>
            </div>
          </article>
        ))}
        <a class="nl-more" href="#">Load More</a>
      </div>

      <aside class="nl-right">
        <!-- Journal subscribe -->
        <form class="nlform" onsubmit="return false" action="#" method="post">
          <h2 class="nlform__title">Subscribe<br />to my Journal</h2>
          <span class="nlform__rule" aria-hidden="true"></span>
          <p class="nlform__text">Get more content from the polar regions, inspiration, tips and exclusive offers sent straight to your inbox.</p>
          <input type="email" name="cm-email" placeholder="Your email address" aria-label="Your email address" />
          <button class="nlform__btn" type="submit">Subscribe</button>
        </form>

        <!-- Book update subscribe -->
        <form class="nlform nlform--book" onsubmit="return false" action="#" method="post">
          <div class="nlform__cover placeholder" role="img" aria-label="Ice in Practice — book cover"></div>
          <span class="nlform__rule" aria-hidden="true"></span>
          <p class="nlform__cta">Receive updates on my book <i>Ice in Practice</i></p>
          <input type="text" name="cm-name" placeholder="Your Name" aria-label="Your Name" />
          <input type="email" name="cm-email" placeholder="Your Email" aria-label="Your Email" />
          <button class="nlform__btn nlform__btn--solid" type="submit">Join Now</button>
        </form>
      </aside>
    </section>

    <!-- ============ BOTTOM: Narrating the Poles / Curiously Polar newsletter ============ -->
    <section class="nlwrap nl-band">
      <span class="nl-band__wm" aria-hidden="true">CURIOUSLY POLAR</span>
      <span class="nl-band__label">Narrating the Poles</span>
      <span class="nl-band__hrule" aria-hidden="true"></span>
      <span class="nl-band__vrule" aria-hidden="true"></span>

      <!-- monthly dose signup -->
      <form class="nl-dose" onsubmit="return false" action="#" method="post">
        <div class="nl-dose__logo placeholder" role="img" aria-label="Curiously Polar"></div>
        <p class="nl-dose__title">Sign up<br />for your<br />monthly dose<br />of polar<br />curiosity</p>
        <p class="nl-dose__text">Stay up to date with our monthly reminders of how awesome, precious and fun the polar regions are.</p>
        <input type="text" name="cm-name" placeholder="Your Name" aria-label="Your Name" />
        <input type="email" name="cm-email" placeholder="Your Email" aria-label="Your Email" />
        <button class="nl-dose__btn" type="submit">Join Now</button>
      </form>

      <!-- carousel arrows -->
      <button class="nl-arrow nl-arrow--prev" type="button" aria-label="Previous">&rarr;</button>
      <button class="nl-arrow nl-arrow--next" type="button" aria-label="Next">&rarr;</button>

      <!-- three newsletter thumbnails -->
      {cpNews.map((n) => (
        <article class="nl-thumb" style={`left:${n.l}`}>
          <div class="nl-thumb__img placeholder" role="img" aria-label="Newsletter thumbnail"></div>
          <h3 class="nl-thumb__title">{n.title}</h3>
          <p class="nl-thumb__date">{n.date}</p>
        </article>
      ))}
    </section>

  </div>
</BaseLayout>

<style>
  .nl { padding-top: 68px; padding-bottom: 4rem; overflow-x: clip; }
  .nlwrap { position: relative; width: min(1129px, calc(100% - 3rem)); margin-inline: auto; }

  /* ===================== TOP TWO-COLUMN ===================== */
  .nl-top { display: flex; gap: 20px; align-items: flex-start; }
  .nl-left { flex: 0 0 64.04%; display: flex; flex-direction: column; gap: 20px; }
  .nl-right { flex: 1 1 auto; display: flex; flex-direction: column; gap: 19px; }

  /* journal card */
  .nlcard { background: #fff; box-shadow: 4px 4px 4px rgba(0,0,0,0.25); padding: 20px; }
  .nlcard__img { width: 100%; aspect-ratio: 683 / 200; }
  .nlcard__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin-top: 10px; }
  .nlcard__meta { min-width: 0; }
  .nlcard__date { margin: 0; font-size: 12px; font-weight: 500; color: rgba(0,0,0,0.5); }
  .nlcard__title { margin: 6px 0 0; font-size: 18px; font-weight: 500; line-height: 1.3; color: #000; letter-spacing: 0; }
  .nlcard__btn { flex: 0 0 auto; width: 128px; height: 40px; display: grid; place-items: center; background: var(--navy); color: #fff; font-size: 14px; font-weight: 300; white-space: nowrap; }
  .nlcard__btn:hover { background: var(--navy-800); }
  .nlcard__bar { font-weight: 300; }
  .nlcard__btn b { font-weight: 700; }

  .nl-more {
    align-self: center; margin-top: 4px; width: 135px; height: 30px; display: grid; place-items: center;
    background: var(--navy); border: 1px solid #fff; color: #fff;
    font-size: 12px; font-weight: 500; letter-spacing: 0.03em; text-transform: uppercase;
  }
  .nl-more:hover { background: var(--navy-800); }

  /* signup forms (navy cards) */
  .nlform { background: var(--navy); color: #fff; text-align: center; padding: 34px 20px 30px; }
  .nlform__title { margin: 0; font-size: 22px; font-weight: 500; line-height: 30px; letter-spacing: 0.1em; text-transform: uppercase; }
  .nlform__rule { display: block; width: 20px; height: 2px; background: #fff; margin: 16px auto; }
  .nlform__text { margin: 0 0 20px; font-size: 12px; font-weight: 300; line-height: 1.5; }
  .nlform input {
    display: block; width: 100%; height: 34px; margin: 0 auto 12px; padding: 0 14px; border: 0; border-radius: 6px;
    font-family: inherit; font-size: 12px; background: #fff; color: #11292e; text-align: center;
  }
  .nlform input::placeholder { color: rgba(0,0,0,0.5); }
  .nlform__btn {
    margin-top: 6px; background: none; border: 0; color: #fff; font-family: inherit; font-size: 14px; font-weight: 300; cursor: pointer;
  }
  .nlform__btn:hover { opacity: 0.75; }
  .nlform__btn--solid {
    width: 100%; height: 44px; background: var(--navy); border: 1px solid #fff; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; margin-top: 8px;
  }
  .nlform__btn--solid:hover { background: rgba(255,255,255,0.12); opacity: 1; }
  .nlform--book { padding-top: 26px; }
  .nlform__cover { width: 203px; max-width: 70%; aspect-ratio: 203 / 305; margin: 0 auto 4px; }
  .nlform__cta { margin: 0 0 18px; font-size: 14px; font-weight: 300; line-height: 1.5; }

  /* ===================== BOTTOM BAND ===================== */
  .nl-band { margin-top: 96px; height: 536px; }
  .nl-band__wm {
    position: absolute; top: -0.16em; left: 0; font-family: var(--font); font-weight: 500;
    font-size: clamp(60px, 13vw, 120px); color: #f5f5f5; white-space: nowrap; line-height: 1;
    pointer-events: none; user-select: none; z-index: 0;
  }
  .nl-band__label {
    position: absolute; top: 29px; left: 20px; z-index: 3; background: var(--paper); padding-right: 14px;
    font-size: 18px; font-weight: 400; letter-spacing: 0.3em; color: #000; text-transform: uppercase; white-space: nowrap;
  }
  .nl-band__hrule { position: absolute; top: 53px; left: 22px; right: 0; height: 1px; background: rgba(17,41,46,0.35); z-index: 1; }
  .nl-band__vrule { position: absolute; top: 52px; left: 22px; width: 1px; height: 108px; background: rgba(17,41,46,0.35); z-index: 1; }

  /* monthly-dose form */
  .nl-dose {
    position: absolute; top: 72px; left: 4.52%; width: 18.95%; z-index: 2;
    background: var(--navy); color: #fff; text-align: center; padding: 0 18px 22px;
  }
  .nl-dose__logo { width: 67px; height: 67px; margin: -33px auto 12px; background: var(--placeholder); border: 3px solid var(--paper); }
  .nl-dose__title { margin: 0 0 16px; font-size: 20px; font-weight: 600; line-height: 22px; text-transform: uppercase; }
  .nl-dose__text { margin: 0 0 20px; font-size: 12px; font-weight: 400; line-height: 1.5; }
  .nl-dose input {
    display: block; width: 100%; height: 34px; margin: 0 auto 10px; padding: 0 14px; border: 0; border-radius: 6px;
    font-family: inherit; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; background: #fff; color: #11292e; text-align: center;
  }
  .nl-dose input::placeholder { color: rgba(0,0,0,0.35); }
  .nl-dose__btn {
    margin-top: 6px; width: 100%; height: 44px; background: var(--navy); border: 1px solid #fff; color: #fff;
    font-family: inherit; font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; cursor: pointer;
  }
  .nl-dose__btn:hover { background: rgba(255,255,255,0.12); }

  /* carousel arrows */
  .nl-arrow {
    position: absolute; top: 99px; width: 40px; height: 40px; display: grid; place-items: center;
    background: var(--navy); border: 0; color: #fff; font-size: 20px; cursor: pointer;
  }
  .nl-arrow:hover { background: var(--navy-800); }
  .nl-arrow--prev { left: 29.05%; transform: scaleX(-1); }  /* flip the → into a ← */
  .nl-arrow--next { left: 33.48%; }

  /* newsletter thumbnails */
  .nl-thumb { position: absolute; top: 165px; width: 22.59%; }
  .nl-thumb__img { width: 100%; aspect-ratio: 1 / 1; }
  .nl-thumb__title { margin: 14px 0 0; font-size: 18px; font-weight: 500; line-height: 24px; letter-spacing: -0.9px; color: rgba(0,0,0,0.65); text-transform: uppercase; }
  .nl-thumb__date { margin: 8px 0 0; font-size: 12px; font-weight: 300; color: rgba(0,0,0,0.65); }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 940px) {
    .nl-top { flex-direction: column; }
    .nl-left, .nl-right { flex: 1 1 auto; width: 100%; }
    .nl-right { max-width: 420px; }

    .nl-band { height: auto; }
    .nl-band__wm { position: static; display: block; margin-bottom: -0.3em; }
    .nl-band__label { position: static; display: inline-block; margin: 0 0 6px; background: none; padding: 0; }
    .nl-band__hrule, .nl-band__vrule, .nl-arrow { display: none; }
    .nl-dose { position: static; width: 100%; max-width: 320px; margin: 0 auto 2.5rem; padding-top: 40px; }
    .nl-dose__logo { margin-top: 0; }
    .nl-thumb { position: static; width: 100%; max-width: 360px; margin: 0 auto 2rem; }
  }
</style>
