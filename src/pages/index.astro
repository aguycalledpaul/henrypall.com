---
import BaseLayout from '../layouts/BaseLayout.astro';

const dispatches = [
  { category: 'Cryosphere', date: 'April 8, 2026', title: 'Thin Ice: The Arctic Sea Ice Maximum of 2026 and the World That Depends On It', excerpt: 'On March 15, the Arctic sea ice reached its 2026 maximum: 14.29 million km², the lowest in the 48-year satellite record. An area twice the size of Texas that never froze. The ice is telling its story.' },
  { category: 'Leadership', date: 'March 21, 2026', title: 'The Briefing Before the Landing: What Expedition Leaders Can Teach Corporate Managers', excerpt: 'Decisions made at sea level, far from support, reveal a discipline of communication and trust that boardrooms rarely have to practice. Here is what the ice teaches about leading under pressure.' },
  { category: 'Changing Poles', date: 'February 15, 2026', title: 'Scramble for the North Pole: Continental Shelf Claims, Geopolitics and the Future of the Arctic Council', excerpt: 'Three nations claim the same seabed. As the Arctic thaws, the pressure to draw new lines on an old map is quietly reshaping the politics of the far north.' },
  { category: 'Cryosphere', date: 'January 30, 2026', title: 'The Colour of Ice: What Blue, White, Green and Black Tell Us About a Glacier’s Life', excerpt: 'Ice is never simply white. Its hues are a diary of pressure, age and origin — a language you can learn to read from the deck of a ship or the foot of a calving face.' },
  { category: 'Geopolitics', date: 'January 9, 2026', title: 'Russia’s Arctic Silence: What Happens to Circumpolar Science When Half the Arctic Is Off-Limits', excerpt: 'When cooperation freezes, the data freezes with it. The gaps left in the record have consequences that reach far beyond any single border.' },
];

const categories = ['Cryosphere', 'Leadership', 'Changing Poles'];

const notes = [
  { title: 'The greatest thing in the world is to know how to belong to oneself', date: 'December 12, 2025' },
  { title: 'Snow that never falls: the physics and poetry of diamond dust', date: 'November 30, 2025' },
  { title: 'The weight of the whistle: personal responsibility on the ice', date: 'November 17, 2025' },
  { title: 'What Shackleton got wrong about the mythology of heroic leadership', date: 'November 2, 2025' },
  { title: 'Sea ice dialects: how Inuit and Sámi encode centuries of knowledge', date: 'October 21, 2025' },
  { title: 'Permafrost’s long goodbye: when the ground stops being permanent', date: 'October 5, 2025' },
];

const lectures = [
  { category: 'Cryosphere', title: 'The greatest thing in the world is to know to belong to oneself' },
  { category: 'Geopolitics', title: 'Reading a warming Arctic: politics, science and the new maps' },
  { category: 'History', title: 'Triumph and defeat: what the age of exploration still teaches us' },
  { category: 'Foundations', title: 'How ice works: a field primer for guides and operators' },
  { category: 'Oceanography', title: 'Currents beneath the ice: the ocean that shapes the poles' },
];
---

<BaseLayout>
  <!-- ============ HERO / DISPATCH CAROUSEL ============ -->
  <section class="hero" data-carousel>
    <div class="wrap hero__inner">
      <div class="hero__viewport" data-scroll>
        {dispatches.map((d) => (
          <div class="hero__slide">
            <span class="hero__date">{d.date}</span>
            <div class="hero__media placeholder"></div>
            <article class="hero__card">
              <span class="tag hero__tag">{d.category}</span>
              <h2 class="hero__title">{d.title}</h2>
              <p class="hero__excerpt">{d.excerpt}</p>
              <a class="readmore readmore--light" href="#"><b>Read</b> More</a>
            </article>
          </div>
        ))}
      </div>
      <div class="hero__nav">
        <button class="arrow" data-arrow="prev" aria-label="Previous dispatch">&larr;</button>
        <button class="arrow" data-arrow="next" aria-label="Next dispatch">&rarr;</button>
      </div>
    </div>
  </section>

  <!-- ============ NEWSLETTER SIGNUP ============ -->
  <section class="container">
    <div class="signup">
      <h2 class="signup__title">Subscribe to my journal</h2>
      <span class="dash"></span>
      <p class="signup__sub">Get more content from the polar regions, inspiration, tips and exclusive offers sent straight to your inbox.</p>
      <form class="signup__form" onsubmit="return false">
        <input type="email" placeholder="Your email address" aria-label="Your email address" />
      </form>
      <button class="signup__btn" type="submit">Subscribe</button>
    </div>
  </section>

  <!-- ============ CATEGORY TEASERS ============ -->
  <section class="tiles container">
    {categories.map((c) => (
      <a class="tile" href="#">
        <span class="placeholder tile__img"></span>
        <span class="tag tile__tag">{c}</span>
      </a>
    ))}
  </section>

  <!-- ============ ABOUT TEASER ============ -->
  <section class="about">
    <div class="wrap about__inner">
      <span class="about__wm">ABOUT</span>
      <div class="about__media">
        <span class="about__shadow"></span>
        <span class="about__img"></span>
      </div>
      <h2 class="about__title">Love has no age no limit and no death.</h2>
      <span class="about__rule"></span>
      <p class="about__text">Consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
      <a class="readmore about__cta" href="#"><b>Read</b> More</a>
    </div>
  </section>

  <!-- ============ FIELD NOTES TEASER ============ -->
  <section class="fieldnotes" data-carousel>
    <div class="wrap fieldnotes__inner">
      <span class="watermark fieldnotes__wm">Field Notes</span>
      <blockquote class="fieldnotes__quote">Do not mind anything that anyone tells you about anyone else. Judge everyone and everything for yourself.</blockquote>
      <div class="fieldnotes__nav nav-arrows">
        <button class="arrow" data-arrow="prev" aria-label="Previous notes">&larr;</button>
        <button class="arrow" data-arrow="next" aria-label="Next notes">&rarr;</button>
      </div>
      <div class="fieldnotes__viewport" data-scroll>
        <div class="fieldnotes__track">
          {notes.map((n) => (
            <article class="note">
              <span class="note__img"></span>
              <h3 class="note__title">{n.title}</h3>
              <span class="note__date">{n.date}</span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LECTURES TEASER ============ -->
  <section class="lectures" data-carousel>
    <div class="wrap lectures__inner">
      <div class="lectures__viewport" data-scroll>
        {lectures.map((l) => (
          <div class="lectures__slide">
            <div class="lectures__media placeholder"></div>
            <article class="lectures__card">
              <span class="lectures__tag">{l.category}</span>
              <h3 class="lectures__title">{l.title}</h3>
              <a class="readmore" href="#"><b>Read</b> More</a>
            </article>
          </div>
        ))}
      </div>
      <span class="lectures__line"></span>
      <span class="lectures__label">Lectures</span>
      <div class="lectures__nav nav-arrows">
        <button class="arrow" data-arrow="prev" aria-label="Previous lecture">&larr;</button>
        <button class="arrow" data-arrow="next" aria-label="Next lecture">&rarr;</button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* content wrapper: content box aligned to the header (logo→search), no padding
     so absolutely-positioned children measure from the content-left */
  .wrap { position: relative; width: min(1104px, calc(100% - 2.5rem)); margin-inline: auto; }

  /* ---------- shared ---------- */
  .readmore { font-size: 0.85rem; color: var(--navy); border-left: 2px solid currentColor; padding-left: 8px; white-space: nowrap; }
  .readmore b { font-weight: 600; }
  .readmore--light { color: #fff; }
  .arrow {
    width: 40px; height: 40px;
    background: var(--navy); color: #fff;
    border: 0; cursor: pointer;
    display: grid; place-items: center;
    font-size: 1rem; flex: 0 0 auto;
  }
  .arrow:hover { background: var(--navy-800); }
  .nav-arrows { display: flex; gap: 6px; }
  [data-scroll] { overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; scroll-behavior: smooth; }
  [data-scroll]::-webkit-scrollbar { display: none; }

  /* ---------- HERO (image 780×500 @14.62%, card 700×250 @+104) ---------- */
  .hero { padding-top: 3.5rem; padding-bottom: 4rem; }
  .hero__inner { position: relative; }
  .hero__viewport { display: flex; scroll-snap-type: x mandatory; }
  .hero__slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; }
  .hero__media { width: 69.52%; margin-left: 14.62%; aspect-ratio: 780 / 500; }
  .hero__date {
    position: absolute;
    left: calc(9.36% + 20px); top: 13.4%;
    transform: translateX(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    font-size: 20px; font-weight: 500; color: var(--navy);
    letter-spacing: 0;
  }
  .hero__card {
    position: absolute;
    top: 20.8%; right: 0;
    width: 62.39%;
    background: var(--navy); color: #fff;
    padding: 2.2rem 2.4rem 1.4rem;
  }
  .hero__tag { position: absolute; left: 0; bottom: calc(100% + 2px); }
  .hero__title {
    color: #fff;
    font-size: clamp(1.3rem, 1.95vw, 1.8rem);
    font-weight: 600;
    text-transform: uppercase; line-height: 1.18; margin-bottom: 0.8rem;
  }
  .hero__excerpt { font-size: 0.85rem; line-height: 1.6; color: #c3ccd1; margin-bottom: 1.1rem; }
  .hero__card .readmore { display: inline-block; float: right; }
  .hero__nav {
    position: absolute;
    left: 9.36%; bottom: 0;      /* bottom arrow bottom-aligns to image bottom */
    display: flex; flex-direction: column; gap: 10px;
  }

  /* ---------- NEWSLETTER ---------- */
  .signup { background: var(--navy); color: #fff; text-align: center; padding: 3rem 1.5rem 3.2rem; margin-top: 1rem; }
  .signup__title { color: #fff; text-transform: uppercase; letter-spacing: 0.24em; font-size: 1.15rem; margin-bottom: 0.5rem; }
  .dash { display: block; width: 24px; height: 2px; background: rgba(255,255,255,0.7); margin: 0.5rem auto 1rem; }
  .signup__sub { font-size: 0.82rem; color: #b9c4c9; margin: 0 auto 1.5rem; max-width: 620px; }
  .signup__form input { width: 100%; max-width: 720px; padding: 0.8rem 1.2rem; border: 0; border-radius: 2px; font-family: inherit; font-size: 0.88rem; text-align: center; }
  .signup__btn { margin-top: 1.2rem; background: none; border: 0; color: #fff; font-family: inherit; font-size: 0.88rem; letter-spacing: 0.04em; cursor: pointer; }
  .signup__btn:hover { opacity: 0.75; }

  /* ---------- CATEGORY TILES ---------- */
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding-top: 4.5rem; padding-bottom: 4.5rem; }
  .tile { position: relative; display: block; }
  .tile__img { display: block; aspect-ratio: 337 / 220; }
  .tile__tag { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); }

  /* ---------- ABOUT (image 498² @left 0, shadow @-32/+29, headline @39.1%) ---------- */
  .about { padding-top: 3rem; padding-bottom: 3rem; }
  .about__inner { height: 555px; }
  .about__wm {
    position: absolute; right: 0; top: -0.35em; z-index: 0;
    font-size: clamp(6rem, 17.8vw, 200px);
    font-weight: 500; letter-spacing: 0; line-height: 1;
    color: #f5f5f5;
  }
  .about__media { position: absolute; left: 0; top: 28px; z-index: 1; width: 44.39%; aspect-ratio: 1 / 1; }
  .about__shadow { position: absolute; left: -32px; top: 29px; width: 100%; height: 100%; background: var(--navy); z-index: 0; }
  .about__img { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; background: var(--placeholder); z-index: 1; }
  .about__title {
    position: absolute; z-index: 2;
    left: 39.13%; top: 73px; width: 46.97%; margin: 0;
    font-size: clamp(1.9rem, 3.55vw, 40px); font-weight: 500;
    text-transform: uppercase; line-height: 1.375;
  }
  .about__rule { position: absolute; z-index: 2; left: 39.13%; top: 203px; width: 98px; height: 2px; background: var(--navy); }
  .about__text { position: absolute; z-index: 2; left: 51.6%; top: 222px; width: 27.99%; margin: 0; color: var(--muted); font-size: 0.85rem; line-height: 1.65; }
  .about__cta { position: absolute; z-index: 2; left: 51.6%; top: 325px; display: inline-block; }

  /* ---------- FIELD NOTES (intro 368px, cards 255px, arrows @24.6%/+256) ---------- */
  .fieldnotes { padding-top: 4rem; padding-bottom: 4rem; }
  .fieldnotes__inner { min-height: 480px; }
  .fieldnotes__wm { position: absolute; top: 0; left: 0; z-index: 0; font-weight: 500; font-size: clamp(3rem, 11vw, 120px); letter-spacing: 0; line-height: 1; }
  .fieldnotes__quote {
    position: absolute; z-index: 1; left: 0; top: 147px; width: 200px;
    font-size: 0.78rem; font-weight: 300; color: var(--muted);
    border-left: 2px solid var(--navy); padding-left: 1rem; margin: 0; line-height: 1.75;
  }
  .fieldnotes__nav { position: absolute; z-index: 2; left: 24.6%; top: 256px; flex-direction: column; gap: 6px; }
  .fieldnotes__viewport { position: relative; z-index: 1; margin-left: 32.8%; padding-top: 5.5rem; }
  .fieldnotes__track { display: flex; gap: 18px; }
  .note { flex: 0 0 calc((100% - 36px) / 3); scroll-snap-align: start; }
  .note__img { display: block; aspect-ratio: 1 / 1; background: var(--placeholder); margin-bottom: 1rem; }
  .note__title { font-size: 0.82rem; font-weight: 600; text-transform: uppercase; line-height: 1.4; margin-bottom: 0.6rem; letter-spacing: 0.02em; }
  .note__date { font-size: 0.76rem; color: var(--muted); }

  /* ---------- LECTURES (image 805×600 @left -34, card 448×319 @61.5%/+71, line @71.8%) ---------- */
  .lectures { padding-top: 3rem; padding-bottom: 5rem; }
  .lectures__inner { position: relative; }
  .lectures__viewport { display: flex; scroll-snap-type: x mandatory; }
  .lectures__slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; }
  .lectures__media { width: 71.75%; margin-left: -3.03%; aspect-ratio: 805 / 600; }
  .lectures__card {
    position: absolute; left: 61.5%; right: auto; top: 11.83%;
    width: 39.93%; min-height: 53.17%;
    background: #fff; box-shadow: 0 18px 55px rgba(17, 41, 46, 0.14);
    padding: 3rem 3.4rem; text-align: center;
  }
  .lectures__tag { display: block; text-transform: uppercase; letter-spacing: 0.24em; font-size: 0.68rem; color: var(--muted); margin-bottom: 1.5rem; }
  .lectures__title { font-size: clamp(1.1rem, 1.6vw, 1.45rem); font-weight: 600; text-transform: uppercase; line-height: 1.3; margin-bottom: 1.6rem; }
  .lectures__card .readmore { display: inline-block; }
  .lectures__line { position: absolute; left: 71.84%; top: 8.33%; width: 2px; height: 84.33%; background: var(--navy); z-index: 3; }
  .lectures__label {
    position: absolute; left: calc(71.84% + 8px); bottom: 2.5rem; z-index: 3;
    writing-mode: vertical-rl; transform: rotate(180deg);
    text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.72rem; color: var(--muted);
  }
  .lectures__nav { position: absolute; right: -1.43%; left: auto; top: 67.3%; z-index: 3; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .hero__media { width: 100%; margin-left: 0; }
    .hero__card { position: static; width: 100%; margin-top: -2.5rem; }
    .hero__date, .hero__nav { display: none; }

    .about__inner { height: auto; }
    .about__wm { position: static; display: block; font-size: clamp(3rem, 14vw, 6rem); margin-bottom: 0.25rem; }
    .about__media { position: relative; width: 78%; margin: 0 0 2.5rem; top: 0; }
    .about__title, .about__rule, .about__text, .about__cta { position: static; left: auto; top: auto; width: auto; }
    .about__rule { margin: 1rem 0; }
    .about__text { margin-bottom: 1.2rem; max-width: 340px; }

    .fieldnotes__inner { min-height: 0; }
    .fieldnotes__wm { position: static; display: block; }
    .fieldnotes__quote { position: static; width: auto; margin-bottom: 1.5rem; }
    .fieldnotes__nav { position: static; flex-direction: row; margin-bottom: 1.5rem; }
    .fieldnotes__viewport { margin-left: 0; padding-top: 0; }
    .note { flex-basis: 70%; }

    .lectures__media { width: 100%; margin-left: 0; }
    .lectures__card { position: static; width: 100%; margin-top: -2rem; }
    .lectures__line, .lectures__label, .lectures__nav { display: none; }
  }
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; }
    .note { flex-basis: 85%; }
  }
</style>

<script>
  document.querySelectorAll('[data-arrow]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('[data-carousel]');
      const scroller = wrap && wrap.querySelector('[data-scroll]');
      if (!scroller) return;
      const dir = btn.getAttribute('data-arrow') === 'next' ? 1 : -1;
      scroller.scrollBy({ left: dir * scroller.clientWidth, behavior: 'smooth' });
    });
  });
</script>
