---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const mods = import.meta.glob('../../lectures/*.md', { eager: true });
  return Object.entries(mods).map(([path, mod]) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
    props: { mod },
  }));
}

const { mod } = Astro.props;
const fm = mod.frontmatter;
const Content = mod.Content;
---

<BaseLayout title={fm.title + ' — Lectures'} description={fm.excerpt} overlayHeader overlayDark={false}>
  <button class="ds-toc" aria-label="Table of contents" type="button">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><line x1="8" y1="7" x2="20" y2="7"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="8" y1="17" x2="20" y2="17"/><circle cx="4" cy="7" r="0.9" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="0.9" fill="currentColor" stroke="none"/><circle cx="4" cy="17" r="0.9" fill="currentColor" stroke="none"/></svg>
  </button>

  <section class="lec-hero">
    <div class="lec-wrap lec-hero__inner">
      <div class="lec-hero__box">
        <span class="lec-hero__cat">{fm.category}</span>
        <h1 class="lec-hero__title">{fm.title}</h1>
        {fm.subtitle && <p class="lec-hero__sub">{fm.subtitle}</p>}
      </div>
    </div>
  </section>

  <div class="lec-wrap">
    <div class="lec-body">
      <article class="lec-prose">
        <Content />
      </article>
    </div>
  </div>

  <div class="ds-tocpop" id="tocPop" role="dialog" aria-label="Table of contents" hidden>
    <p class="ds-tocpop__title">Contents</p>
    <nav class="ds-toc__list" id="tocList"></nav>
  </div>
</BaseLayout>

<style>
  .lec-wrap { position: relative; width: min(1102px, calc(100% - 2.5rem)); margin-inline: auto; }

  /* floating TOC icon + popover */
  .ds-toc { position: fixed; left: 18px; top: 42%; z-index: 15; width: 44px; height: 44px; display: grid; place-items: center; background: #fff; border: 1px solid #e3e7e9; border-radius: 4px; box-shadow: 0 6px 20px rgba(17,41,46,0.10); color: var(--navy); cursor: pointer; }
  .ds-toc:hover { border-color: var(--navy); }
  .ds-toc.is-open { background: var(--navy); color: #fff; border-color: var(--navy); }
  @media (max-width: 1180px) { .ds-toc { display: none; } }
  .ds-tocpop { position: fixed; left: 70px; top: 42%; z-index: 16; width: 288px; max-height: 78vh; overflow-y: auto; background: #fff; border: 1px solid #e3e7e9; border-radius: 8px; box-shadow: 0 16px 44px rgba(17,41,46,0.16); padding: 16px 18px; scrollbar-width: thin; }
  .ds-tocpop[hidden] { display: none; }
  .ds-tocpop::before { content: ""; position: absolute; left: -7px; top: 46px; width: 12px; height: 12px; background: #fff; border-left: 1px solid #e3e7e9; border-bottom: 1px solid #e3e7e9; transform: rotate(45deg); }
  .ds-tocpop__title { margin: 0 0 0.5rem; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #8b9498; }
  @media (max-width: 1180px) { .ds-tocpop { display: none; } }
  .ds-toc__list { display: flex; flex-direction: column; counter-reset: toc; }
  .ds-toc__list a { counter-increment: toc; display: flex; gap: 10px; align-items: baseline; padding: 9px 2px; border-bottom: 1px solid #eef1f2; color: #000; text-decoration: none; font-size: 12.5px; line-height: 1.35; }
  .ds-toc__list a:last-child { border-bottom: 0; }
  .ds-toc__list a:hover { color: var(--navy); }
  .ds-toc__list a::before { content: counter(toc, decimal-leading-zero); color: #d52e2e; font-size: 10px; font-weight: 600; flex: 0 0 auto; }

  /* ===== hero — grey full-bleed; navy title box 704 wide at x409 ===== */
  .lec-hero { position: relative; background: var(--placeholder); }
  .lec-hero__inner { height: 893px; }
  .lec-hero__box { position: absolute; left: 240px; right: 158px; bottom: 174px; background: var(--navy); color: #fff; padding: 21px 29px 30px; }
  /* category chip: navy #11292e, 129×36, flush with box left, sitting just above the box */
  .lec-hero__cat { position: absolute; left: 0; bottom: calc(100% + 1px); width: 129px; height: 36px; display: flex; align-items: center; padding-left: 22px; box-sizing: border-box; background: #11292e; color: #fff; font-size: 14px; font-weight: 300; letter-spacing: 0.02em; text-transform: uppercase; }
  .lec-hero__title { margin: 0; color: #fff; font-family: 'Poppins', sans-serif; font-size: clamp(28px, 3.4vw, 40px); font-weight: 500; text-transform: uppercase; line-height: 1.125; letter-spacing: 0; }
  .lec-hero__sub { margin: 11px 0 0; color: #fff; font-size: 14px; font-weight: 300; }

  /* ===== offset column: body 944 (169–1113), prose 704 right-aligned (409–1113) ===== */
  .lec-body { width: min(944px, 100%); padding: 56px 0 120px; }
  .lec-prose { width: 704px; max-width: 100%; margin-left: auto; color: #000; }

  /* prose type — exact Figma values */
  .lec-prose :global(h2) { margin: 2.6rem 0 0.8rem; font-size: 16px; font-weight: 500; text-transform: uppercase; letter-spacing: 0; color: #000; line-height: 1.3; }
  .lec-prose :global(h3) { margin: 1.7rem 0 0.55rem; font-size: 12px; font-weight: 300; font-style: italic; color: #000; line-height: 1.4; }
  .lec-prose :global(p) { margin: 0 0 0.85rem; font-size: 11px; font-weight: 300; line-height: 1.6; color: #000; }
  .lec-prose :global(strong) { font-weight: 600; }
  .lec-prose :global(.lec-standfirst) { font-style: italic; font-size: 14px; font-weight: 300; line-height: 1.55; color: #000; margin-bottom: 0.6rem; }
  .lec-prose :global(.lec-ref) { font-style: italic; white-space: nowrap; }
  .lec-prose :global(.lec-cite) { color: #d52e2e; font-style: italic; text-decoration: underline; }

  /* intro rule: 129px wide, 2px navy, left-aligned */
  .lec-prose :global(.lec-rule) { width: 129px; height: 0; border: 0; border-top: 2px solid var(--navy); margin: 1.1rem 0 2.2rem; }

  /* ===== figures ===== */
  .lec-prose :global(figure) { margin: 1.6rem 0; }
  .lec-prose :global(.lec-fig__img), .lec-prose :global(.lec-illus), .lec-prose :global(.lec-quote__img) { background: var(--placeholder); }
  .lec-prose :global(.lec-fig__img) { width: 100%; aspect-ratio: var(--ar, 704 / 310); }
  .lec-prose :global(figcaption) { margin-top: 8px; padding-left: 12px; border-left: 2px solid #000; font-style: italic; font-size: 10px; line-height: 1.45; color: #000; }
  .lec-prose :global(.lec-fig__src) { display: block; margin-top: 2px; font-style: normal; font-size: 8px; color: rgba(0,0,0,0.55); }

  /* breakout wide figure (944, x169) */
  .lec-prose :global(.lec-fig--wide) { width: calc(100% + 240px); margin-left: -240px; }

  /* figure with left-gutter illustration (Picture 3 + Additional Illustration 1) */
  .lec-prose :global(.lec-fig--withillus) { width: calc(100% + 202px); margin-left: -202px; display: flex; gap: 10px; align-items: flex-start; }
  .lec-prose :global(.lec-fig--withillus .lec-illus) { flex: 0 0 192px; display: flex; flex-direction: column; gap: 8px; }
  .lec-prose :global(.lec-illus__box) { width: 100%; aspect-ratio: var(--ar, 192 / 194); background: var(--placeholder); }
  .lec-prose :global(.lec-fig--withillus .lec-fig__main) { flex: 1 1 auto; min-width: 0; }

  /* right-floated inset (Picture 4 inset, 298×236) */
  .lec-prose :global(.lec-fig--inset) { float: right; width: 298px; margin: 4px 0 12px 24px; }

  /* split: subsection text left, picture right (Subsection 3 + Picture 6, 393 wide) */
  .lec-prose :global(.lec-fig--floatright) { float: right; width: 393px; max-width: 55%; margin: 4px 0 12px 24px; }

  /* multi-up rows with exact Figma column ratios (all cells 310 tall) */
  .lec-prose :global(.lec-fig--2up) { display: grid; grid-template-columns: 338fr 350fr; gap: 16px; }
  .lec-prose :global(.lec-fig--3up) { display: grid; grid-template-columns: 222fr 222fr 249fr; gap: 6px; }
  .lec-prose :global(.lec-fig--5up) { width: calc(100% + 240px); margin-left: -240px; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .lec-prose :global(.lec-fig--2up figcaption), .lec-prose :global(.lec-fig--3up figcaption), .lec-prose :global(.lec-fig--5up figcaption) { grid-column: 1 / -1; }

  /* centred in-lecture quote: rule → 330×163 picture → text → rule, all centred (480 wide) */
  .lec-prose :global(.lec-fig--quote) { width: 480px; max-width: 100%; margin: 2.4rem auto; text-align: center; }
  .lec-prose :global(.lec-quote__rule) { width: 100px; height: 0; border: 0; border-top: 1px solid var(--navy); margin: 0 auto; }
  .lec-prose :global(.lec-quote__img) { width: 330px; max-width: 100%; margin: 20px auto; aspect-ratio: 330 / 163; }
  .lec-prose :global(.lec-fig--quote blockquote) { margin: 20px auto; font-style: italic; font-size: 14px; line-height: 1.55; color: #000; text-align: center; }

  @media (max-width: 1000px) {
    .lec-hero__inner { height: 560px; }
    .lec-hero__box { left: 0; right: 0; bottom: 40px; }
    .lec-body { width: 100%; padding: 40px 0 80px; }
    .lec-prose { width: 100%; }
    .lec-prose :global(.lec-fig--wide), .lec-prose :global(.lec-fig--5up), .lec-prose :global(.lec-fig--withillus) { width: 100%; margin-left: 0; }
    .lec-prose :global(.lec-fig--inset), .lec-prose :global(.lec-fig--floatright) { float: none; width: 100%; max-width: 100%; margin: 1.2rem 0; }
    .lec-prose :global(.lec-fig--quote) { width: 100%; }
  }
  @media (max-width: 560px) {
    .lec-prose :global(.lec-fig--5up) { grid-template-columns: repeat(2, 1fr); }
    .lec-prose :global(.lec-fig--withillus) { flex-direction: column; }
    .lec-prose :global(.lec-fig--withillus .lec-illus) { flex-direction: row; }
  }
</style>

<script>
  const tocList = document.getElementById('tocList');
  const tocPop = document.getElementById('tocPop');
  const tocBtn = document.querySelector('.ds-toc');
  function closeToc() { if (tocPop) tocPop.hidden = true; if (tocBtn) tocBtn.classList.remove('is-open'); }
  function toggleToc() { if (!tocPop) return; const open = tocPop.hidden; tocPop.hidden = !open; if (tocBtn) tocBtn.classList.toggle('is-open', open); }
  if (tocList) {
    document.querySelectorAll('.lec-prose h2').forEach((h) => {
      if (!h.id) return;
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent.replace(/\s+/g, ' ').trim();
      a.addEventListener('click', (e) => { e.preventDefault(); closeToc(); const t = document.getElementById(h.id); if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      tocList.appendChild(a);
    });
  }
  if (tocBtn) tocBtn.addEventListener('click', (e) => { e.stopPropagation(); toggleToc(); });
  document.addEventListener('click', (e) => { if (tocPop && !tocPop.hidden && !tocPop.contains(e.target) && !tocBtn.contains(e.target)) closeToc(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeToc(); });
</script>
